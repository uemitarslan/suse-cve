STATUS_ALIASES = {
    "rel": "RELEASED",
    "released": "RELEASED",
    "fix": "RELEASED",
    "fixed": "RELEASED",
    "qa": "IN QA",
    "inqa": "IN QA",
    "in_qa": "IN QA",
