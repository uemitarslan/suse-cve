    "affected": "AFFECTED",
    "wont": "WONT FIX",
    "wontfix": "WONT FIX",
}

USE_COLOR = sys.stdout.isatty()

if USE_COLOR:
    CLR_RESET = "\033[0m"
    CLR_BOLD = "\033[1m"
    CLR_DIM = "\033[2m"
    CLR_WARN = "\033[1;33m"
    CLR_CYAN = "\033[1;36m"
    CLR_MAG = "\033[1;35m"
    PALETTE = {
        "RELEASED": {"header": "\033[1;32m", "pkg": "\033[32m"},
        "IN QA": {"header": "\033[1;33m", "pkg": "\033[33m"},
        "IN PROGRESS": {"header": CLR_CYAN, "pkg": CLR_CYAN},
        "AFFECTED": {"header": "\033[1;31m", "pkg": "\033[31m"},
        "NOT AFFECTED": {"header": "\033[1;36m", "pkg": "\033[36m"},
        "WONT FIX": {"header": "\033[1;34m", "pkg": "\033[34m"},
    }
else:
    CLR_RESET = ""
    CLR_BOLD = ""
    CLR_DIM = ""
    CLR_WARN = ""
    CLR_CYAN = ""
    CLR_MAG = ""
    PALETTE = {}


def clean_pkg_name(raw_name: str) -> str:
    if not raw_name or raw_name.lower() in ("open", "no", "is", "installed", "all"):
        return ""
    low = raw_name.lower()
    if "livepatch" in low:
        return "kernel-livepatch"
    if "kgraft-patch" in low:
        return "kgraft-patch"
    m = re.match(r'^([a-zA-Z0-9_\-]+?)(?:-\d+.*|$)', raw_name)
    if m:
        return m.group(1).rstrip("-")
    return raw_name


def filter_packages_for_platform(platform: str, pkgs: set) -> set:
    """Filter kGraft/Livepatch noise out of SLES 12/15 base modules, keeping Livepatch for SLES 16 / Micro 6."""
    low = platform.lower()
    if "live patching" in low or "16." in low or "micro 6" in low:
        return pkgs
    return {p for p in pkgs if p not in ("kgraft-patch", "kernel-livepatch")}


def build_platform_regex(rel_arg: str):
    s = rel_arg.lower().replace("sles", "").replace("sle", "").strip("- _")
    if s in ("all", "*"):
        return "ALL", "", re.compile(r"(?:12|15|16)", re.IGNORECASE)
    m_micro = re.match(r"^(?:sl-?micro|micro)-?([56])\.?(\d+)$|^([56])\.(\d+)$", s)
    if m_micro:
        maj = m_micro.group(1) or m_micro.group(3)
        minor = m_micro.group(2) or m_micro.group(4)
        return f"MICRO{maj}", minor, re.compile(rf"(?:Enterprise|Linux)\s+Micro\s+{maj}\.{minor}\b", re.IGNORECASE)

    m = re.search(r'(\d+)(?:[-. ]?sp|\.)?(\d+)?', s)
    major = m.group(1) if m else "15"
    sp = m.group(2) if (m and m.group(2)) else ""

    if sp:
        pattern = rf"(?=.*\b{major}\b)(?=.*(?:sp\s*{sp}|service pack\s*{sp}|{major}\.{sp}))"
        regex = re.compile(pattern, re.IGNORECASE)
    else:
        regex = re.compile(rf"\b{major}\b", re.IGNORECASE)

    return major, sp, regex


def get_oval_timestamp(major: str):
    """Return (formatted timestamp string, UTC datetime object)."""
    fpath = os.path.join(DATA_DIR, f"suse.linux.enterprise.{major}.xml.bz2")
    if not os.path.exists(fpath):
        return "N/A", None
    try:
        with bz2.open(fpath, "rb") as bz:
            chunk = bz.read(2048).decode("utf-8", errors="ignore")
            m = re.search(r"<(?:\w+:)?timestamp>([^<]+)</(?:\w+:)?timestamp>", chunk)
            if m:
                raw_ts = m.group(1).split(".")[0]
                dt = datetime.strptime(raw_ts, "%Y-%m-%dT%H:%M:%S").replace(tzinfo=timezone.utc)
                return dt.strftime("%Y-%m-%d %H:%M UTC"), dt
    except Exception:
        pass
    return "N/A", None


def sync_oval_files():
    """Download latest OVAL dumps and rebuild the local SQLite index."""
    os.makedirs(DATA_DIR, exist_ok=True)
    print(f"\n{CLR_BOLD}=== Starting manual OVAL sync ==={CLR_RESET}")
    for url in OVAL_URLS:
        fname = os.path.basename(url)
        dest = os.path.join(DATA_DIR, fname)
        print(f"Downloading {fname} ...", flush=True)
        subprocess.run(
            ["curl", "-sL", "-z", dest, "-o", dest, url],
            check=False
        )
    build_index()


def extract_pkgs_from_cell(cell_html: str) -> set:
    """Extract normalized package names from an HTML table cell."""
    pkgs = set()
    items = re.findall(r'<(?:code|a)[^>]*>(.*?)</(?:code|a)>', cell_html, re.DOTALL | re.IGNORECASE)
    if not items:
        plain = re.sub(r'<[^>]+>', ' ', cell_html)
        plain = plain.replace("&gt;", ">").replace("&lt;", "<")
        items = re.findall(r'([a-zA-Z0-9_.\-]+)\s*(?:>=|=|<)', plain)
        if not items:
            items = [plain.strip()]

    for raw in items:
        clean_str = re.sub(r'<[^>]+>', '', raw).replace("&gt;", ">").strip()
        clean_str = re.sub(r'\s*(?:>=|=|<).*', '', clean_str).strip()
        p = clean_pkg_name(clean_str)
        if p and len(p) > 1 and not p.startswith("SUSE-"):
            pkgs.add(p)
    return pkgs


def extract_patchnames_from_cell(cell_html: str) -> list:
    """Extract SUSE patch IDs and architectures from column 3 ('Patchnames: ...')."""
    plain = re.sub(r'<[^>]+>', ' ', cell_html)
    plain = re.sub(r'\s+', ' ', plain).strip()
    matches = re.findall(r'(SUSE-[A-Za-z0-9_.\-]+)\s*\(([^)]+)\)', plain)
    results = []
    seen = set()
    for p_id, arch_str in matches:
        if p_id not in seen:
            seen.add(p_id)
            archs = [a.strip() for a in arch_str.split(",") if a.strip()]
            results.append({"patch": p_id, "archs": archs})
    return results


def fetch_web_data(cve_id: str, platform_regex):
    url = f"https://www.suse.com/security/cve/{cve_id}.html"
    web_map = {}
    patch_map = {}
    bugzilla_urls = []
    web_last_modified_str = "N/A"
    web_dt = None
    web_all_prods_for_major = set()
    web_all_active_prods = set()

    try:
        proc = subprocess.run(
            ["curl", "-sIL", "--connect-timeout", "4", "--max-time", "10", url],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=True
        )
        head_out = proc.stdout.decode("utf-8", errors="ignore")
        m_mod = re.findall(r"last-modified:\s*([^\r\n]+)", head_out, re.IGNORECASE)
        if m_mod:
            raw_web_ts = m_mod[-1].strip()
            try:
                web_dt = parsedate_to_datetime(raw_web_ts).astimezone(timezone.utc)
                web_last_modified_str = web_dt.strftime("%Y-%m-%d %H:%M UTC")
            except Exception:
                web_last_modified_str = raw_web_ts

        proc_body = subprocess.run(
            ["curl", "-sL", "--connect-timeout", "4", "--max-time", "10", url],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=True
        )
        html = proc_body.stdout.decode("utf-8", errors="ignore")
    except Exception:
        return web_map, patch_map, bugzilla_urls, web_last_modified_str, web_dt, web_all_prods_for_major, False

    # Extract Bugzilla links (used by --mitigate)
    bz_matches = re.findall(r'https?://bugzilla\.suse\.com/show_bug\.cgi\?id=\d+', html, re.IGNORECASE)
    seen_bz = set()
    for b in bz_matches:
        if b not in seen_bz:
            seen_bz.add(b)
            bugzilla_urls.append(b)

    # 1. 'List of packages in QA'
    def extract_prods_from_cell(cell_html: str) -> list:
        parts = re.split(r'(?:<br\s*/?>|</li>|</p>|</div>|\n)+', cell_html, flags=re.IGNORECASE)
        res = []
        for p in parts:
            txt = re.sub(r'\s+', ' ', re.sub(r'<[^>]+>', ' ', p)).strip()
            if not txt or "product" in txt.lower():
                continue
            if (
                txt.startswith("Container ")
                or txt.startswith("Image ")
                or txt.lower().startswith("opensuse")
                or ("/" in txt and "suse linux" not in txt.lower())
            ):
                continue
            res.append(txt)
        return res

    m_qa = re.search(r'List of packages in QA.*?<table[^>]*>(.*?)</table>', html, re.DOTALL | re.IGNORECASE)
    if m_qa:
        for row in re.findall(r'<tr[^>]*>(.*?)</tr>', m_qa.group(1), re.DOTALL | re.IGNORECASE):
            tds = re.findall(r'<td[^>]*>(.*?)</td>', row, re.DOTALL | re.IGNORECASE)
            if len(tds) >= 2:
                prods = extract_prods_from_cell(tds[0])
                pkgs = extract_pkgs_from_cell(tds[1])
                for prod in prods:
                    web_all_prods_for_major.add(prod)
                    web_all_active_prods.add(prod)
                    if platform_regex.search(prod) and pkgs:
                        web_map.setdefault("IN QA", {}).setdefault(prod, set()).update(pkgs)

    # 2. Parse all table rows (Released Packages table & Status table)
    for row in re.findall(r'<tr[^>]*>(.*?)</tr>', html, re.DOTALL | re.IGNORECASE):
        tds = re.findall(r'<td[^>]*>(.*?)</td>', row, re.DOTALL | re.IGNORECASE)
        if len(tds) < 2:
            continue

        prods = extract_prods_from_cell(tds[0])
        if not prods:
            continue

        # Case A: 'List of Released Packages' table (column 3 contains Patchnames / SUSE advisories)
        if len(tds) >= 3 and ("patchnames:" in tds[2].lower() or re.search(r'SUSE-(?:SLE|SU|RU|FU)-', tds[2])):
            pkgs = extract_pkgs_from_cell(tds[1])
            patches = extract_patchnames_from_cell(tds[2])
            for prod in prods:
                web_all_prods_for_major.add(prod)
                web_all_active_prods.add(prod)
                if platform_regex.search(prod):
                    if pkgs:
                        web_map.setdefault("RELEASED", {}).setdefault(prod, set()).update(pkgs)
                    if patches:
                        existing = {item["patch"] for item in patch_map.get(prod, [])}
                        for pt in patches:
                            if pt["patch"] not in existing:
                                patch_map.setdefault(prod, []).append(pt)
                                existing.add(pt["patch"])
            continue

        # Case B: Standard status table (Product | Package | Status)
        found_status = None
        pkg_cell = ""
        for td in tds[1:]:
            clean_td = re.sub(r'<[^>]+>', ' ', td).strip()
            norm = STATUS_ALIASES.get(clean_td.lower())
            if norm or "cve-status" in td or clean_td.lower() in ("released", "affected", "not affected", "wont fix"):
                found_status = norm if norm else clean_td.upper()
            elif not pkg_cell:
                pkg_cell = td

        if found_status:
            pkgs = extract_pkgs_from_cell(pkg_cell) if pkg_cell else set()
            if not pkgs and found_status == "NOT AFFECTED":
                pkgs = {"(not affected)"}
            for prod in prods:
                web_all_prods_for_major.add(prod)
                if found_status != "NOT AFFECTED":
                    web_all_active_prods.add(prod)
                if pkgs and (platform_regex.search(prod) or found_status == "NOT AFFECTED"):
                    web_map.setdefault(found_status, {}).setdefault(prod, set()).update(pkgs)

    suse_intel = {}
    m_st = re.search(r"Overall state of this security issue:\s*([^<\n]+)", html, re.IGNORECASE)
    if m_st:
        suse_intel["state"] = m_st.group(1).strip()
    m_rt = re.search(r"rated as having\s*<a[^>]*>([^<]+)</a>\s*severity", html, re.IGNORECASE)
    if m_rt:
        suse_intel["rating"] = m_rt.group(1).strip().upper()
    m_v3 = re.search(r"CVSS v3 Scores.*?<td>Base Score</td>\s*<td>[^<]*</td>\s*<td>([^<]+)</td>\s*</tr>\s*<tr><td>Vector</td>\s*<td>[^<]*</td>\s*<td>([^<]+)</td>", html, re.DOTALL | re.IGNORECASE)
    if m_v3:
        suse_intel["cvss3"] = f"{m_v3.group(1).strip()} ({m_v3.group(2).strip()})"
    m_v4 = re.search(r"CVSS v4 Scores.*?<td>Base Score</td>\s*<td>([^<]+)</td>\s*</tr>\s*<tr><td>Vector</td>\s*<td>([^<]+)</td>", html, re.DOTALL | re.IGNORECASE)
    if m_v4:
        v4_vec = re.sub(r"(?:/[A-Z]+:X)+$", "", m_v4.group(2).strip()); suse_intel["cvss4"] = f"{m_v4.group(1).strip()} ({v4_vec})"
    web_map["_SUSE_INTEL"] = suse_intel
    web_map["_ALL_ACTIVE_PRODS"] = web_all_active_prods
    return web_map, patch_map, bugzilla_urls, web_last_modified_str, web_dt, web_all_prods_for_major, True


import threading
from concurrent.futures import ThreadPoolExecutor

_KEV_LOCK = threading.Lock()
_KEV_INDEX = None


class _ThreadLocalStream:
    def __init__(self, fallback):
        self._fallback = fallback
        self._local = threading.local()

    def set_target(self, stream):
        self._local.stream = stream

    def clear_target(self):
        if hasattr(self._local, "stream"):
            delattr(self._local, "stream")

    def _target(self):
        return getattr(self._local, "stream", self._fallback)

    def write(self, data):
        return self._target().write(data)

    def flush(self):
        return self._target().flush()

    def isatty(self):
        t = self._target()
        return t.isatty() if hasattr(t, "isatty") else False

    def __getattr__(self, name):
        return getattr(self._target(), name)


def fetch_cisa_kev(cve_id: str):
    """Check the public CISA KEV catalog (Public Domain) with thread-safe in-memory index cache."""
    global _KEV_INDEX
    kev_url = "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json"
    cache_file = os.path.join(DATA_DIR, "cisa_kev.json")

    with _KEV_LOCK:
        if _KEV_INDEX is None:
            data = None
            try:
                need_download = True
                if os.path.exists(cache_file):
                    age_h = (datetime.now(timezone.utc).timestamp() - os.path.getmtime(cache_file)) / 3600.0
                    if age_h < 12:
                        need_download = False

                if need_download:
                    os.makedirs(DATA_DIR, exist_ok=True)
                    tmp_file = f"{cache_file}.tmp.{os.getpid()}"
                    subprocess.run(
                        ["curl", "-sL", "--connect-timeout", "4", "--max-time", "8", "-o", tmp_file, kev_url],
                        stderr=subprocess.DEVNULL,
                        check=False
                    )
                    if os.path.exists(tmp_file) and os.path.getsize(tmp_file) > 100:
                        os.replace(tmp_file, cache_file)
                    elif os.path.exists(tmp_file):
                        os.remove(tmp_file)

                if os.path.exists(cache_file):
                    with open(cache_file, "r", encoding="utf-8", errors="ignore") as f:
                        data = json.load(f)
            except Exception:
                return None

            idx = {}
            if isinstance(data, dict):
                for item in data.get("vulnerabilities", []):
                    cid = item.get("cveID", "").upper()
                    if cid:
                        idx[cid] = {
                            "exploited": True,
                            "vendor": item.get("vendorProject", "N/A"),
                            "product": item.get("product", "N/A"),
                            "date_added": item.get("dateAdded", "N/A"),
                            "due_date": item.get("dueDate", "N/A"),
                            "ransomware": item.get("knownRansomwareCampaignUse", "Unknown"),
                            "required_action": item.get("requiredAction", "")
                        }
            _KEV_INDEX = idx

    return _KEV_INDEX.get(cve_id.upper(), {"exploited": False})


def fetch_redhat_intel(cve_id: str) -> dict:
    """Fetch official mitigation and statement texts from Red Hat Security Data API (CC BY 4.0)."""
    rh_url = f"https://access.redhat.com/hydra/rest/securitydata/cve/{cve_id}.json"
    res = {"mitigation": "", "statement": "", "bugzilla_desc": "", "source": rh_url}
    try:
        proc = subprocess.run(
            ["curl", "-sL", "--connect-timeout", "4", "--max-time", "8", "-H", "User-Agent: suse-cve-cli/1.0", rh_url],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=True
        )
        raw = proc.stdout.decode("utf-8", errors="ignore").strip()
        if not raw or not raw.startswith("{"):
            return res
        data = json.loads(raw)

        mit = data.get("mitigation")
        if isinstance(mit, dict):
            res["mitigation"] = re.sub(r'\s+', ' ', mit.get("value", "")).strip()
        elif isinstance(mit, str):
            res["mitigation"] = re.sub(r'\s+', ' ', mit).strip()

        stmt = data.get("statement")
        if isinstance(stmt, dict):
            res["statement"] = re.sub(r'\s+', ' ', stmt.get("value", "")).strip()
        elif isinstance(stmt, str):
            res["statement"] = re.sub(r'\s+', ' ', stmt).strip()

        bz = data.get("bugzilla")
        if isinstance(bz, dict):
            res["bugzilla_desc"] = bz.get("description", "").strip()

        res["page_url"] = f"https://access.redhat.com/security/cve/{cve_id}"
        if "see the security bulletin" in res["mitigation"].lower():
            try:
                import html as _html
                proc_p = subprocess.run(
                    ["curl", "-sL", "--connect-timeout", "4", "--max-time", "8", "-H", "User-Agent: suse-cve-cli/1.0", res["page_url"]],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                    check=True
                )
                p_html = proc_p.stdout.decode("utf-8", errors="ignore")
                m_rhsb = re.search(r"(RHSB-\d{4}-\d+)", p_html)
                if m_rhsb:
                    rhsb_id = m_rhsb.group(1)
                    res["page_url"] = f"https://access.redhat.com/security/vulnerabilities/{rhsb_id}"
                    res["rhsb_id"] = rhsb_id
                    proc_b = subprocess.run(
                        ["curl", "-sL", "--connect-timeout", "4", "--max-time", "8", "-H", "User-Agent: suse-cve-cli/1.0", res["page_url"]],
                        stdout=subprocess.PIPE,
                        stderr=subprocess.DEVNULL,
                        check=True
                    )
                    b_html = proc_b.stdout.decode("utf-8", errors="ignore")
                    b_txt = re.sub(r"\s+", " ", _html.unescape(re.sub(r"<[^>]+>", " ", b_html))).strip()
                    m_sec = re.search(r"Mitigation\s+(.*?)(?:Reverting After Patching|Affected Packages|Acknowledgements)", b_txt, re.I)
                    if m_sec and len(m_sec.group(1)) > 30:
                        res["mitigation"] = m_sec.group(1).strip()[:1600]
            except Exception:
                pass
    except Exception:
        pass
    return res


def fetch_ubuntu_notes(cve_id: str) -> dict:
    """Fetch security maintainer notes and Mitigation section from Ubuntu Security (CC BY-SA)."""
    ub_json_url = f"https://ubuntu.com/security/cves/{cve_id}.json"
    ub_html_url = f"https://ubuntu.com/security/{cve_id}"
    res = {"notes": [], "mitigation": "", "url": ub_html_url}
    try:
        proc = subprocess.run(
            ["curl", "-sL", "--connect-timeout", "4", "--max-time", "8", "-H", "User-Agent: suse-cve-cli/1.0", ub_json_url],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=True
        )
        raw = proc.stdout.decode("utf-8", errors="ignore").strip()
        if raw and raw.startswith("{"):
            data = json.loads(raw)
            for n in data.get("notes", []):
                txt = n.get("note", "").strip()
                if txt and len(txt) > 15:
                    res["notes"].append(re.sub(r'\s+', ' ', txt))
            res["notes"] = res["notes"][:3]
    except Exception:
        pass

    try:
        import html as _html
        proc_h = subprocess.run(
            ["curl", "-sL", "--connect-timeout", "4", "--max-time", "8", "-H", "User-Agent: suse-cve-cli/1.0", ub_html_url],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=True
        )
        page = proc_h.stdout.decode("utf-8", errors="ignore")
        m_mit = re.search(r"id=[\"']mitigation[\"'][^>]*>.*?</h[23]>(.*?)(?:<h[23]\b|</section>)", page, re.S | re.I)
        if m_mit:
            cleaned = _html.unescape(re.sub(r"<[^>]+>", " ", m_mit.group(1)))
            cleaned = re.sub(r"\s+", " ", cleaned).strip()
            if len(cleaned) > 30:
                res["mitigation"] = cleaned[:1600]
    except Exception:
        pass
    return res


def fetch_suse_bugzilla_workarounds(bugzilla_urls: list) -> list:
    """Fetch public comments from SUSE Bugzilla REST API and extract workaround/mitigation guidance."""
    findings = []
    seen_ids = set()
    for url in (bugzilla_urls or [])[:3]:
        m = re.search(r'[?&]id=(\d+)', url)
        if not m:
            continue
        bz_id = m.group(1)
        if bz_id in seen_ids:
            continue
        seen_ids.add(bz_id)
        api_url = f"https://bugzilla.suse.com/rest/bug/{bz_id}/comment"
        try:
            proc = subprocess.run(
                ["curl", "-sL", "--connect-timeout", "4", "--max-time", "6", "-H", "User-Agent: suse-cve-cli/1.0", api_url],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                check=True
            )
            raw = proc.stdout.decode("utf-8", errors="ignore").strip()
            if not raw.startswith("{"):
                continue
            data = json.loads(raw)
            comments = data.get("bugs", {}).get(bz_id, {}).get("comments", [])
            for idx, cm in enumerate(comments):
                if idx == 0:
                    continue  # Skip initial boilerplate bug description
                raw_txt = cm.get("text", "").strip()
                if not raw_txt:
                    continue
                # Strip quoted reply lines
                lines = [ln.strip() for ln in raw_txt.splitlines() if ln.strip() and not ln.strip().startswith(">")]
                if not lines:
                    continue
                # Evaluate paragraph-by-paragraph to avoid capturing surrounding discussion chatter
                paras = [p.strip() for p in re.split(r'\n\s*\n', "\n".join(lines)) if p.strip()]
                for para in paras:
                    clean_txt = re.sub(r'\s+', ' ', para).strip()
                    # Skip questions, subjective speculation, or bare URLs without actionable instructions
                    if clean_txt.endswith("?") and re.search(r'\b(is there|any|does|can|will|what|why|how)\b', clean_txt[:60], re.I):
                        continue
                    if re.search(r"\b(I've read|to me,? that means|I think|I guess|not sure if|seems like|in my opinion)\b", clean_txt, re.I):
                        continue
                    no_urls = re.sub(r'https?://\S+', '', clean_txt).strip()
                    if len(no_urls) < 35:
                        continue
                    # Require both a mitigation keyword AND an actionable directive/config signal
                    has_kw = re.search(r'\b(workaround|mitigat\w*|temporary fix|disable\s+\w+|sysctl|blacklist|-XX:)\b', no_urls, re.I)
                    has_action = re.search(r'\b(set|disable|enable|configure|change|restrict|block|remove|avoid|use|add|edit|sysctl|modprobe|systemctl|/etc/|/sys/|-XX:)\b', no_urls, re.I)
                    if has_kw and has_action:
                        if len(clean_txt) > 360:
                            cut = clean_txt[:360]
                            last_dot = max(cut.rfind(". "), cut.rfind("; "))
                            clean_txt = cut[:last_dot + 1].strip() if last_dot > 120 else cut.rsplit(" ", 1)[0].strip() + "..."
                        findings.append((bz_id, clean_txt))
        except Exception:
            continue
    return findings[:3]


def _enrich_suggestions_for_crisis(cve_id: str, suggestions: list) -> list:
    default_urls = [
        f"https://www.suse.com/security/cve/{cve_id}.html",
        f"https://nvd.nist.gov/vuln/detail/{cve_id}",
    ]

    def _derive_rollback(cmd_str: str) -> str:
        c = (cmd_str or "").strip()
        if not c or c.startswith("#") or c.startswith("true"):
            return ""
        if "nft -f -" in c and "table inet " in c:
            m_t = re.search(r"table inet ([A-Za-z0-9_]+)", c)
            tbl = m_t.group(1) if m_t else "cve_mitigation"
            return f"rm -f /etc/nftables.d/{tbl}.nft && nft delete table inet {tbl} 2>/dev/null || true"
        if c.startswith("sysctl -w "):
            m_sc = re.search(r"(/etc/sysctl\.d/[A-Za-z0-9_.\-]+\.conf)", c)
            sc_file = m_sc.group(1) if m_sc else "/etc/sysctl.d/99-cve-mitigation.conf"
            return f"rm -f {sc_file} && sysctl --system"
        if "LoginGraceTime 0" in c and "/etc/ssh/sshd_config.d/" in c:
            return "rm -f /etc/ssh/sshd_config.d/99-cve-mitigation.conf && sshd -t && systemctl reload sshd"
        if "/etc/modprobe.d/" in c and "install " in c:
            m_mp = re.search(r"(/etc/modprobe\.d/[A-Za-z0-9_.\-]+\.conf)", c)
            mp_file = m_mp.group(1) if m_mp else "/etc/modprobe.d/cve-mitigation.conf"
            mods = re.findall(r"install\s+([A-Za-z0-9_\-]+)\s+/bin/true", c)
            mod_reload = f" && modprobe {' '.join(mods)}" if mods else ""
            return f"rm -f {mp_file}{mod_reload}"
        if "DefaultEnvironment=" in c and "99-cve-java.conf" in c:
            return "rm -f /etc/systemd/system.conf.d/99-cve-java.conf /etc/profile.d/cve-java.sh && systemctl daemon-reload"
        if "/etc/tomcat/conf.d" in c:
            return "rm -f /etc/tomcat/conf.d/99-cve-mitigation.conf && (spacewalk-service restart 2>/dev/null || systemctl try-restart tomcat taskomatic rhn-search)"
        if "chmod 600 /boot/grub2/grub.cfg" in c:
            return "chmod 644 /boot/grub2/grub.cfg  # Optional: restore default permissions after patched grub2 reboot"
        return ""

    for s in suggestions:
        if not s.get("source_attribution"):
            s["source_attribution"] = "SUSE / NVD Security Hardening Guidance"
        if not s.get("source_urls"):
            s["source_urls"] = list(default_urls)
        if "rollback" not in s:
            rb = _derive_rollback(s.get("cmd", ""))
            if rb:
                s["rollback"] = rb
    return suggestions


def generate_mitigation_report(cve_id: str, bugzilla_urls: list, affected_pkgs: set, suse_intel: dict = None) -> dict:
    """Combine CISA KEV, Red Hat Security Data (CC BY 4.0), Ubuntu Tracker, NVD, and SUSE Bugzilla."""
    nvd_url = f"https://services.nvd.nist.gov/rest/json/cves/2.0?cveId={cve_id}"
    description = ""
    cvss_score = "N/A"
    attack_vector = "UNKNOWN"
    cwes = []
    vendor_refs = []

    try:
        proc = subprocess.run(
            ["curl", "-sL", "--connect-timeout", "4", "--max-time", "8", "-H", "User-Agent: suse-cve-cli/1.0", nvd_url],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=True
        )
        data = json.loads(proc.stdout.decode("utf-8", errors="ignore"))
        vulns = data.get("vulnerabilities", [])
        if vulns:
            cve_obj = vulns[0].get("cve", {})
            for d in cve_obj.get("descriptions", []):
                if d.get("lang") == "en":
                    description = d.get("value", "")
                    break
            metrics = cve_obj.get("metrics", {})
            for m_key in ("cvssMetricV31", "cvssMetricV30", "cvssMetricV2"):
                if m_key in metrics and metrics[m_key]:
                    cvss_data = metrics[m_key][0].get("cvssData", {})
                    cvss_score = f"{cvss_data.get('baseScore', 'N/A')} ({cvss_data.get('baseSeverity', '')})"
                    attack_vector = cvss_data.get("attackVector", "UNKNOWN")
                    break
            for w in cve_obj.get("weaknesses", []):
                for wd in w.get("description", []):
                    val = wd.get("value", "")
                    if val.startswith("CWE-"):
                        cwes.append(val)
            seen_refs = set()
            for ref in cve_obj.get("references", []):
                r_url = ref.get("url", "").strip()
                tags = ref.get("tags", [])
                if r_url and r_url not in seen_refs:
                    if any(d in r_url.lower() for d in ("suse.com", "github.com/advisories", "php.net", "mozilla.org", "openssh.com")) or any(t in tags for t in ("Vendor Advisory", "Mitigation")):
                        seen_refs.add(r_url)
                        vendor_refs.append(r_url)
    except Exception:
        pass

    kev_info = fetch_cisa_kev(cve_id)
    rh_info = fetch_redhat_intel(cve_id)
    ub_data = fetch_ubuntu_notes(cve_id)
    ub_notes = ub_data.get("notes", []) if isinstance(ub_data, dict) else (ub_data or [])
    ub_mit = ub_data.get("mitigation", "") if isinstance(ub_data, dict) else ""
    ub_url = ub_data.get("url", f"https://ubuntu.com/security/{cve_id}") if isinstance(ub_data, dict) else f"https://ubuntu.com/security/{cve_id}"
    rh_page_url = rh_info.get("page_url") or f"https://access.redhat.com/security/cve/{cve_id}"
    rh_label = f"Red Hat ({rh_info['rhsb_id']})" if rh_info.get("rhsb_id") else "Red Hat Security"

    if not description and rh_info.get("bugzilla_desc"):
        description = rh_info["bugzilla_desc"]

    core_desc = description[:500]
    rh_mit = rh_info.get("mitigation", "")
    if "see the security bulletin" in rh_mit.lower():
        rh_mit = ""
    full_intel = " ".join([description, rh_mit, ub_mit, " ".join(ub_notes)]).lower()
    combined_intel = core_desc.lower()

    suggestions = []

    # Detect IPv4 TCP IP-options / ip hdrlength > 5 firewall mitigation (e.g. CVE-2026-98432)
    if ("ip hdrlength" in full_intel or ("inet_opt" in full_intel and "ireq_opt" in full_intel) or "ip options" in full_intel):
        src_names = []
        src_urls = []
        if "ip hdrlength" in rh_mit.lower() or rh_info.get("rhsb_id"):
            src_names.append(rh_label)
            src_urls.append(rh_page_url)
        if "ip hdrlength" in ub_mit.lower() or "ip options" in ub_mit.lower():
            src_names.append("Ubuntu Security")
            src_urls.append(ub_url)
        if not src_names:
            src_names = [rh_label, "Ubuntu Security"]
            src_urls = [rh_page_url, ub_url]
        safe_tbl = re.sub(r"[^A-Za-z0-9_]", "_", cve_id.lower())
        suggestions.append({
            "title": "Drop incoming IPv4 TCP packets carrying IP options via nftables (reduces exposure without reboot)",
            "source_attribution": " & ".join(src_names),
            "source_urls": src_urls,
            "cmd": (
                f"nft -f - <<'EOF'\n"
                f"add table inet {safe_tbl}\n"
                f"delete table inet {safe_tbl}\n"
                f"table inet {safe_tbl} {{\n"
                f"  chain input {{\n"
                f"    type filter hook input priority -310; policy accept;\n"
                f"    ip protocol tcp ip hdrlength > 5 counter drop\n"
                f"  }}\n"
                f"}}\n"
                f"EOF\n"
                f"nft list table inet {safe_tbl}  # Remove after kernel reboot: nft delete table inet {safe_tbl}"
            )
        })

    # Detect tcp_migrate_req / MPTCP sysctl hardening mentioned in kernel advisory / vendor bulletins
    if "tcp_migrate_req" in full_intel:
        suggestions.append({
            "title": "Disable TCP request socket migration (closes secondary migration race vector)",
            "source_attribution": "Upstream Linux Kernel CNA / NVD Advisory",
            "source_urls": [f"https://nvd.nist.gov/vuln/detail/{cve_id}"],
            "cmd": f"sysctl -w net.ipv4.tcp_migrate_req=0 && echo 'net.ipv4.tcp_migrate_req = 0' > /etc/sysctl.d/99-{cve_id.lower()}-migrate.conf"
        })
    if "mptcp" in full_intel or "net.mptcp.enabled" in full_intel:
        suggestions.append({
            "title": "Ensure Multipath TCP (MPTCP) is disabled unless required",
            "source_attribution": f"{rh_label} / Kernel Advisory",
            "source_urls": [rh_page_url],
            "cmd": f"sysctl -w net.mptcp.enabled=0 2>/dev/null || true"
        })

    if "io_uring" in combined_intel:
        suggestions.append({
            "title": "Disable io_uring (SLES 15 SP4+ / 16)",
            "source_attribution": "Linux Kernel / SUSE Security Hardening",
            "source_urls": [f"https://www.suse.com/security/cve/{cve_id}.html"],
            "cmd": "sysctl -w kernel.io_uring_disabled=2 && echo 'kernel.io_uring_disabled = 2' >> /etc/sysctl.d/99-cve-mitigation.conf"
        })
    if any(k in combined_intel for k in ("nf_tables", "netfilter", "nft_", "iptables")):
        suggestions.append({
            "title": "Restrict unprivileged user namespaces (blocks Netfilter/nf_tables privilege escalation)",
            "cmd": "sysctl -w user.max_user_namespaces=0 && echo 'user.max_user_namespaces = 0' >> /etc/sysctl.d/99-cve-mitigation.conf"
        })
    if any(k in combined_intel for k in ("ebpf", "bpf_", "bpf verifier", "unprivileged_bpf")):
        suggestions.append({
            "title": "Disable unprivileged eBPF",
            "cmd": "sysctl -w kernel.unprivileged_bpf_disabled=1 && echo 'kernel.unprivileged_bpf_disabled = 1' >> /etc/sysctl.d/99-cve-mitigation.conf"
        })
    if "overlayfs" in combined_intel or "ovl_" in combined_intel:
        suggestions.append({
            "title": "Restrict unprivileged user namespaces and OverlayFS mounts",
            "cmd": "sysctl -w user.max_user_namespaces=0 && echo 'blacklist overlay' > /etc/modprobe.d/cve-mitigation.conf"
        })
    if any(k in combined_intel for k in ("bluetooth", "bluez", "rfcomm", "hci_")):
        suggestions.append({
            "title": "Blacklist Bluetooth kernel modules on servers",
            "cmd": "printf 'install bluetooth /bin/true\\ninstall btusb /bin/true\\n' > /etc/modprobe.d/cve-bluetooth.conf"
        })
    if "logingracetime" in combined_intel or "sshd" in combined_intel or "openssh" in combined_intel:
        suggestions.append({
            "title": "Set OpenSSH LoginGraceTime to 0 (mitigates pre-auth race conditions such as regreSSHion)",
            "cmd": "echo 'LoginGraceTime 0' > /etc/ssh/sshd_config.d/99-cve-mitigation.conf && systemctl reload sshd"
        })
    for proto in ("tipc", "rds", "sctp", "dccp", "nfc"):
        if re.search(rf"\b{proto}\b", combined_intel):
            suggestions.append({
                "title": f"Blacklist uncommon network protocol '{proto}' via modprobe",
                "cmd": f"echo 'install {proto} /bin/true' > /etc/modprobe.d/cve-{proto}.conf && modprobe -r {proto} 2>/dev/null || true"
            })
    if any(k in combined_intel for k in ("af_can", "can_raw", "can protocol", "controller area network")):
        suggestions.append({
            "title": "Blacklist CAN bus kernel module 'can' via modprobe",
            "cmd": "echo 'install can /bin/true' > /etc/modprobe.d/cve-can.conf && modprobe -r can 2>/dev/null || true"
        })
    if any(k in combined_intel for k in ("cifs", "smb3", "ksmbd", "nfsd")):
        suggestions.append({
            "title": "Restrict SMB/NFS ports on untrusted interfaces via firewalld",
            "cmd": "firewall-cmd --list-services  # Verify active samba/nfs services and restrict to trusted zones"
        })
    if any(k in combined_intel for k in ("use-after-free", "heap-based buffer overflow", "out-of-bounds", "privilege escalation", "user namespace")):
        if not any("max_user_namespaces" in s["cmd"] for s in suggestions):
            suggestions.append({
                "title": "Restrict unprivileged user namespaces (blocks common Linux LPE exploit chains)",
                "cmd": "sysctl -w user.max_user_namespaces=0 && echo 'user.max_user_namespaces = 0' >> /etc/sysctl.d/99-cve-mitigation.conf"
            })

    drv_matches = re.findall(r'(?:drivers|fs|net|sound)/[a-zA-Z0-9_/\-]+', description)
    if drv_matches:
        mod_hint = os.path.basename(drv_matches[0]).replace(".c", "")
        suggestions.append({
            "title": f"Inspect or blacklist affected kernel subsystem ({drv_matches[0]})",
            "cmd": f"lsmod | grep -i '{mod_hint}'  # If unused: echo 'install {mod_hint} /bin/true' > /etc/modprobe.d/cve-drv.conf"
        })

    is_kernel_pkg = any(p.startswith("kernel") or "-kmp-" in p for p in affected_pkgs)
    is_xen_pkg = any(p == "xen" or p.startswith("xen-") for p in affected_pkgs)
    is_qemu_pkg = any(p == "qemu" or p.startswith("qemu-") for p in affected_pkgs)
    is_java_pkg = any(p == "java" or p.startswith("java-") or "openjdk" in p or "graalvm" in p for p in affected_pkgs) or bool(re.search(r"\b(java se|openjdk|graalvm|hotspot)\b", combined_intel))
    is_go_pkg = any(p.startswith("go1.") or p.startswith("golang-") or p in ("go", "go-doc", "go-race") for p in affected_pkgs)
    is_php_pkg = any(p == "php" or p.startswith("php7") or p.startswith("php8") for p in affected_pkgs) or bool(re.search(r"\bphp\b", combined_intel))
    is_grub_pkg = any(p == "grub2" or p.startswith("grub2-") for p in affected_pkgs) or bool(re.search(r"\bgrub2?\b", combined_intel))
    is_cpu_sidechannel = any(k in combined_intel for k in ("transient execution", "l1d cache", "side-channel", "side channel", "speculative"))

    if not affected_pkgs:
        suggestions = [{
            "title": "No SLES packages affected -- no local workaround required",
            "cmd": "true  # System is not affected according to SUSE OVAL & Security Advisory metadata"
        }]
    else:
        if is_grub_pkg:
            suggestions.append({
                "title": "Restrict write access to GRUB2 configuration and verify Secure Boot state",
                "cmd": "chmod 600 /boot/grub2/grub.cfg && mokutil --sb-state  # Ensure only root can modify boot config & disable untrusted serial console input"
            })
        if is_cpu_sidechannel or is_xen_pkg:
            if is_cpu_sidechannel:
                suggestions.append({
                    "title": "Disable SMT/Hyper-Threading to mitigate cross-thread L1D/cache transient execution leaks across VMs",
                    "cmd": "cat /sys/devices/system/cpu/smt/control; echo off > /sys/devices/system/cpu/smt/control  # For Xen Dom0 boot: set smt=0 in /etc/default/grub"
                })
            if is_xen_pkg:
                suggestions.append({
                    "title": "Inspect Xen hypervisor CPU mitigation status and isolate untrusted guest VMs (host reboot required once patched)",
                    "cmd": "xl dmesg | grep -iE 'spec|smt|vuln|l1d' && xl list  # Schedule Dom0 reboot after Xen patch installation"
                })
        elif is_qemu_pkg:
            suggestions.append({
                "title": "Restrict untrusted guest/management access to QEMU instances and plan VM live-migration/restart upon patching",
                "cmd": "virsh list --all 2>/dev/null || pgrep -a qemu-system  # Audit running guests; restart QEMU processes after update"
            })

    if affected_pkgs:
        # Multi-source workaround harvester: Red Hat mitigation + SUSE Bugzilla comments + Ubuntu + NVD + SUSE Intel
        bz_workarounds = fetch_suse_bugzilla_workarounds(bugzilla_urls)
        if rh_mit and not any(s.get("source_urls") and rh_page_url in s.get("source_urls", []) for s in suggestions):
            suggestions.insert(0, {
                "title": f"Vendor Upstream Mitigation ({rh_label}): {rh_mit}",
                "source_attribution": rh_label,
                "source_urls": [rh_page_url],
                "cmd": "# Review and apply the upstream workaround above to your affected SLES service/subsystem until SUSE patch release"
            })
        for bz_id, bz_txt in bz_workarounds:
            suggestions.insert(0, {
                "title": f"SUSE Bugzilla #{bz_id} Workaround Note: {bz_txt}",
                "source_attribution": f"SUSE Bugzilla #{bz_id}",
                "source_urls": [f"https://bugzilla.suse.com/show_bug.cgi?id={bz_id}"],
                "cmd": f"# Verify upstream bug report and apply only if applicable to your SLES environment"
            })

        ub_str = " ".join(str(x) for x in ub_notes) if isinstance(ub_notes, list) else str(ub_notes or "")
        bz_str = " ".join(t for _, t in bz_workarounds)
        raw_vendor_blob = " ".join([
            str(description or ""),
            str(rh_mit or ""),
            str(rh_info.get("statement", "") or ""),
            ub_str,
            bz_str,
            json.dumps(suse_intel or {})
        ])

        # Generic extraction of explicit JVM flags (-XX:...), sysctl settings, and modprobe blacklists
        jvm_flags = sorted(set(re.findall(r"-XX:[+-][A-Za-z0-9_]+", raw_vendor_blob)))
        if is_java_pkg and any(k in combined_intel for k in ("compiler", "intrinsic", "base64", "graalvm", "c2", "jit")):
            if "-XX:-UseBASE64Intrinsics" not in jvm_flags:
                jvm_flags.append("-XX:-UseBASE64Intrinsics")

        if jvm_flags:
            flag_str = " ".join(sorted(set(jvm_flags)))
            suggestions.append({
                "title": f"Apply JVM mitigation ({flag_str}) across systemd Java services (SUMA Taskomatic, rhn-search, Tomcat) & shells",
                "cmd": f"mkdir -p /etc/systemd/system.conf.d && printf '[Manager]\\nDefaultEnvironment=\"JDK_JAVA_OPTIONS={flag_str}\"\\n' > /etc/systemd/system.conf.d/99-cve-java.conf && echo 'export JDK_JAVA_OPTIONS=\"{flag_str}\"' > /etc/profile.d/cve-java.sh && systemctl daemon-reload"
            })
            suggestions.append({
                "title": f"Configure Tomcat drop-in (/etc/tomcat/conf.d) with {flag_str} and restart Java / SUSE Manager services",
                "cmd": f"[ -d /etc/tomcat/conf.d ] && echo 'JAVA_OPTS=\"${{JAVA_OPTS}} {flag_str}\"' > /etc/tomcat/conf.d/99-cve-mitigation.conf; spacewalk-service restart 2>/dev/null || systemctl try-restart tomcat taskomatic rhn-search"
            })

        if is_java_pkg:
            suggestions.append({
                "title": "Verify active JVM flags on all running Java processes (Tomcat, Taskomatic, rhn-search)",
                "cmd": "ps -ef | grep -E '[j]ava'  # Confirm mitigation flags are present in active JVM args (or check via jcmd <PID> VM.flags)"
            })
        if is_php_pkg:
            suggestions.append({
                "title": "Disable stateful apache2-mod_php and isolate PHP via PHP-FPM with single-request worker recycling (blocks OOM/longjmp heap reuse)",
                "cmd": "a2dismod php7; a2dismod php8; systemctl enable --now php-fpm && grep -q '^pm.max_requests' /etc/php*/fpm/pool.d/www.conf || echo 'pm.max_requests = 1' >> /etc/php8/fpm/pool.d/www.conf"
            })
            suggestions.append({
                "title": "Tighten PHP memory_limit and request size caps to prevent attacker-controlled OOM triggers",
                "cmd": "grep -E '^(memory_limit|post_max_size|max_input_vars)' /etc/php*/*/php.ini  # Lower memory_limit (e.g. 128M) & reload php-fpm/apache2"
            })

        # Extract explicit vendor workaround sentences from NVD description when present
        if description:
            nvd_sentences = re.split(r'(?<=[.!?])\s+', re.sub(r'\s+', ' ', description).strip())
            wa_sents = [
                s.strip() for s in nvd_sentences
                if re.search(r'\b(alternatively|workaround|mitigat\w*|ensure that|use different|disable\s+\w+)\b', s, re.I)
                and not re.search(r'\b(no publicly available exploits|upgrade to fixed version only)\b', s, re.I)
            ]
            if wa_sents:
                nvd_wa_txt = " ".join(wa_sents)
                if len(nvd_wa_txt) > 360:
                    cut = nvd_wa_txt[:360]
                    last_dot = cut.rfind(". ")
                    nvd_wa_txt = cut[:last_dot + 1].strip() if last_dot > 100 else cut.rsplit(" ", 1)[0].strip() + "..."
                suggestions.append({
                    "title": f"Upstream Advisory Guidance (NVD): {nvd_wa_txt}",
                    "cmd": "# Apply configuration hardening/isolation above to affected service configs until SUSE package update is installed"
                })

        if not suggestions:
            if is_kernel_pkg and any(k in combined_intel for k in ("perf", "pmu")):
                suggestions.append({
                    "title": "Restrict unprivileged perf_event access and harden local kernel interfaces until patch/livepatch is applied",
                    "cmd": "sysctl -w kernel.perf_event_paranoid=3 user.max_user_namespaces=0 kernel.unprivileged_bpf_disabled=1 kernel.kptr_restrict=2"
                })
            elif is_kernel_pkg and attack_vector == "NETWORK":
                suggestions.append({
                    "title": "No generic sysctl/module workaround available -- check kernel livepatch and restrict exposed network ports",
                    "cmd": "zypper lp  # Check if a cumulative kernel livepatch (klp) is available; otherwise restrict ports via firewall-cmd"
                })
            elif is_kernel_pkg or attack_vector == "LOCAL":
                suggestions.append({
                    "title": "Harden local access and kernel interfaces until patch/livepatch is applied",
                    "cmd": "sysctl -w user.max_user_namespaces=0 kernel.unprivileged_bpf_disabled=1 kernel.kptr_restrict=2"
                })
            elif is_go_pkg:
                suggestions.append({
                    "title": "Audit affected Go services/binaries (statically linked Go dependencies require updated package rebuilds and daemon restarts)",
                    "cmd": f"zypper lp && zypper lu --cve={cve_id}  # Update affected Go-based packages and restart running services"
                })
            elif attack_vector == "NETWORK":
                suggestions.append({
                    "title": "Restrict network exposure of the affected service until vendor patch is released",
                    "cmd": "firewall-cmd --list-all  # Restrict external network access to affected service ports"
                })
            else:
                suggestions.append({
                    "title": "No automated configuration workaround available -- restrict untrusted access and monitor SUSE advisory for patch release",
                    "cmd": f"zypper lp && zypper lu --cve={cve_id}  # Verify patch availability; restart affected services/host once released"
                })


    return {
        "cve_id": cve_id,
        "cvss": cvss_score,
        "attack_vector": attack_vector,
        "cwes": sorted(list(set(cwes))),
        "cisa_kev": kev_info,
        "description": description if description else "No public NVD/vendor description available yet (possibly still under embargo / reserved).",
        "redhat_mitigation": rh_info.get("mitigation", ""),
        "redhat_statement": rh_info.get("statement", ""),
        "ubuntu_notes": ub_notes,
        "suse_intel": suse_intel or {},
        "bugzilla": bugzilla_urls,
        "vendor_refs": vendor_refs[:5],
        "suggestions": _enrich_suggestions_for_crisis(cve_id, list({s["cmd"]: s for s in suggestions}.values())),
        "workaround_disclaimer": 'Note: Workarounds are provided as-is without warranty and may not apply 1:1 to every environment. Service names, config paths (e.g., Tomcat, systemd, or wrapper layouts), and runtime flags can vary across SLES releases, SUSE Manager/Uyuni, or custom deployments—verify and adapt to your local setup before applying in production.',
        "sources": [
            "NVD API v2.0 (Public Domain)",
            "CISA KEV Catalog (Public Domain)",
            "Red Hat Security Data API (CC BY 4.0)",
            "Ubuntu CVE Tracker (CC BY-SA)"
        ]
    }




# Official SUSE Linux Enterprise Lifecycle Reference (General Support & LTSS end dates)
SLES_LIFECYCLE_FALLBACK = {
    "SLES 12 SP1": {"general_eol": "2017-10-31", "ltss_eol": "2020-10-31"},
    "SLES 12 SP2": {"general_eol": "2018-03-31", "ltss_eol": "2021-03-31"},
    "SLES 12 SP3": {"general_eol": "2019-06-30", "ltss_eol": "2022-06-30"},
    "SLES 12 SP4": {"general_eol": "2020-06-30", "ltss_eol": "2023-06-30"},
    "SLES 12 SP5": {"general_eol": "2024-10-31", "ltss_eol": "2027-10-31"},
    "SLES 15 SP1": {"general_eol": "2021-01-31", "ltss_eol": "2024-01-31"},
    "SLES 15 SP2": {"general_eol": "2021-12-31", "ltss_eol": "2024-12-31"},
    "SLES 15 SP3": {"general_eol": "2022-12-31", "ltss_eol": "2025-12-31"},
    "SLES 15 SP4": {"general_eol": "2023-12-31", "ltss_eol": "2026-12-31"},
    "SLES 15 SP5": {"general_eol": "2024-12-31", "ltss_eol": "2027-07-31"},
    "SLES 15 SP6": {"general_eol": "2025-12-31", "ltss_eol": "2028-07-31"},
    "SLES 15 SP7": {"general_eol": "2028-07-31", "ltss_eol": "2031-07-31"},
    "SLES 16.0":   {"general_eol": "2030-10-31", "ltss_eol": "2033-10-31"},
    "SLES 16.1":   {"general_eol": "2031-10-31", "ltss_eol": "2034-10-31"},
    "SL Micro 5.4": {"general_eol": "2024-11-30", "ltss_eol": None},
    "SL Micro 5.5": {"general_eol": "2026-04-30", "ltss_eol": None},
    "SL Micro 6.0": {"general_eol": "2026-10-31", "ltss_eol": None},
    "SL Micro 6.1": {"general_eol": "2028-04-30", "ltss_eol": None},
    "SL Micro 6.2": {"general_eol": "2029-10-31", "ltss_eol": None},
}


def load_sles_lifecycle() -> dict:
    """Load SLES lifecycle data from cached endoflife.date API (7-day TTL) merged with built-in SUSE matrix."""
    lifecycle = {k: dict(v) for k, v in SLES_LIFECYCLE_FALLBACK.items()}
    cache_file = os.path.join(DATA_DIR, "sles_lifecycle.json")
    api_url = "https://endoflife.date/api/sles.json"

    try:
        need_fetch = True
        if os.path.exists(cache_file):
            age_days = (datetime.now(timezone.utc).timestamp() - os.path.getmtime(cache_file)) / 86400.0
            if age_days < 7:
                need_fetch = False

        if need_fetch:
            os.makedirs(DATA_DIR, exist_ok=True)
            subprocess.run(
                ["curl", "-sL", "--connect-timeout", "4", "--max-time", "5", "-o", cache_file, api_url],
                stderr=subprocess.DEVNULL,
                check=False
            )

        if os.path.exists(cache_file):
            with open(cache_file, "r", encoding="utf-8", errors="ignore") as f:
                entries = json.load(f)
            if isinstance(entries, list):
                for item in entries:
                    cyc = str(item.get("cycle", "")).strip()
                    eol = item.get("eol")
                    ext = item.get("extendedSupport")
                    if not cyc:
                        continue
                    if cyc.startswith("16"):
                        key = f"SLES {cyc}" if "." in cyc else f"SLES {cyc}.0"
                    elif "-" in cyc:
                        maj, sp_part = cyc.split("-", 1)
                        key = f"SLES {maj} {sp_part.upper()}"
                    else:
                        continue
                    entry = lifecycle.setdefault(key, {})
                    if isinstance(eol, str) and len(eol) >= 10:
                        entry["general_eol"] = eol[:10]
                    if isinstance(ext, str) and len(ext) >= 10:
                        entry["ltss_eol"] = ext[:10]
    except Exception:
        pass

    return lifecycle


def evaluate_release_lifecycle(sles_tag: str, lifecycle_map: dict) -> dict:
    """Evaluate current lifecycle phase (GENERAL_SUPPORT, LTSS_ONLY, EOL, or UNKNOWN) against today's UTC date."""
    today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    info = lifecycle_map.get(sles_tag)
    if not info:
        return {"state": "UNKNOWN", "label": "Unknown lifecycle", "general_eol": "N/A", "ltss_eol": "N/A"}

    gen_eol = info.get("general_eol", "")
    ltss_eol = info.get("ltss_eol", "")

    if gen_eol and today <= gen_eol:
        return {
            "state": "GENERAL_SUPPORT",
            "label": f"General Support (until {gen_eol})",
            "general_eol": gen_eol,
            "ltss_eol": ltss_eol or "N/A"
        }
    if ltss_eol and today <= ltss_eol:
        return {
            "state": "LTSS_ONLY",
            "label": f"LTSS Only (General EOL {gen_eol}; LTSS until {ltss_eol})",
            "general_eol": gen_eol or "N/A",
            "ltss_eol": ltss_eol
        }
    return {
        "state": "EOL",
        "label": f"END OF LIFE (General EOL {gen_eol}, LTSS ended {ltss_eol or gen_eol})",
        "general_eol": gen_eol or "N/A",
        "ltss_eol": ltss_eol or "N/A"
    }


def summarize_affected_sles_releases(cve: str, web_all_prods: set, web_map: dict) -> list:
    """Return a clean sorted list of affected SLES major/minor releases (e.g. 'SLES 15 SP5', 'SLES 16.0')."""
    releases = set()

    def extract_sles_tag(text: str):
        m_mic = re.search(r"(?:Enterprise|Linux)\s+Micro\s+([56])\.(\d+)\b", text, re.IGNORECASE)
        if m_mic:
            return f"SL Micro {m_mic.group(1)}.{m_mic.group(2)}"
        low = text.lower()
        if "opensuse" in low or low.startswith("container ") or low.startswith("image "):
            return None
        # Match SLES / SLE 12, 15, 16 with optional SP or minor version
        m = re.search(r'(?:suse linux enterprise|sle[s]?)[^0-9]*\b(12|15|16)(?:[.\s-]*(?:sp|service pack)?\s*(\d+))?', low)
        if not m:
            return None
        maj = m.group(1)
        minor = m.group(2)
        if maj == "16":
            return f"SLES 16.{minor if minor else '0'}"
        if minor:
            return f"SLES {maj} SP{minor}"
        return f"SLES {maj}"

    # 1. Check local SQLite OVAL database across all majors (12, 15, 16)
    all_active_prods = set(web_map.get("_ALL_ACTIVE_PRODS", set()))
    for st_act in ("RELEASED", "IN QA", "IN PROGRESS", "AFFECTED"):
        all_active_prods.update(web_map.get(st_act, {}).keys())
    strictly_na_prods = set(web_map.get("NOT AFFECTED", {}).keys()) - all_active_prods
    active_tags = {extract_sles_tag(p) for p in all_active_prods if extract_sles_tag(p)}
    strictly_na_tags = {extract_sles_tag(p) for p in strictly_na_prods if extract_sles_tag(p)} - active_tags

    if os.path.exists(DB_PATH):
        conn = sqlite3.connect(DB_PATH)
        cur = conn.cursor()
        cur.execute("SELECT DISTINCT platform FROM cve_catalog WHERE cve=?", (cve,))
        for (plat,) in cur.fetchall():
            if plat in strictly_na_prods:
                continue
            tag = extract_sles_tag(plat)
            if tag and tag not in strictly_na_tags:
                releases.add(tag)
        conn.close()

    # 2. Merge live web products (excluding strictly NOT AFFECTED)
    for prod in (web_all_prods | all_active_prods):
        if prod in strictly_na_prods:
            continue
        tag = extract_sles_tag(prod)
        if tag:
            releases.add(tag)

    # Remove generic 'SLES 15' if specific SPs like 'SLES 15 SP5' exist
    for maj in ("12", "15"):
        if any(r.startswith(f"SLES {maj} SP") for r in releases):
            releases.discard(f"SLES {maj}")

    return sorted(releases)


def query(rel_arg: str, cve_arg: str, status_filter: str = None, as_json: bool = False, with_mitigation: bool = False, config_mode: str = None, force_workaround: bool = False, view_mode: str = 'all', allow_prompt: bool = True):
    if not os.path.exists(DB_PATH):
        if as_json:
            print(json.dumps({"error": "Local database not found. Run 'suse-cve --sync' first."}))
            sys.exit(0 if want_help else 1)
        print(f"{CLR_BOLD}Local database not found.{CLR_RESET}")
        if allow_prompt and sys.stdin.isatty():
            ans = input("Download and build initial OVAL index now? [Y/n]: ").strip().lower()
            if ans in ("", "y", "yes"):
                sync_oval_files()
                return query(rel_arg, cve_arg, status_filter, as_json=as_json, with_mitigation=with_mitigation, allow_prompt=False)
        sys.exit(1)

    cve = cve_arg.strip().rstrip(".,;:").upper()
    if not cve.startswith("CVE-"):
        cve = f"CVE-{cve}"
    if not re.match(r"^CVE-\d{4}-\d{4,}$", cve):
        print(f"Error: Invalid CVE identifier '{cve_arg}'. Expected format: CVE-YYYY-NNNN+", file=sys.stderr)
        sys.exit(1)

    major, sp, sp_regex = build_platform_regex(rel_arg)
    oval_ts_str, oval_dt = get_oval_timestamp("15" if major == "ALL" else major)
    web_map, patch_map, bugzilla_urls, web_ts_str, web_dt, web_all_prods, web_ok = fetch_web_data(cve, sp_regex)

    diff_hours = 0
    is_stale = False
    fpath = os.path.join(DATA_DIR, f"suse.linux.enterprise.{'15' if major == 'ALL' else major}.xml.bz2")
    recently_synced = False
    if os.path.exists(fpath):
        file_age_hours = (datetime.now(timezone.utc).timestamp() - os.path.getmtime(fpath)) / 3600.0
        if file_age_hours < 24:
            recently_synced = True

    if oval_dt and web_dt and not recently_synced:
        diff_hours = (web_dt - oval_dt).total_seconds() / 3600.0
        if diff_hours > STALE_THRESHOLD_HOURS:
            is_stale = True

    if is_stale and not as_json and allow_prompt and sys.stdin.isatty():
        days = int(diff_hours // 24)
        rem_h = int(diff_hours % 24)
        age_str = f"{days}d {rem_h}h" if days > 0 else f"{rem_h}h"
        print(f"{CLR_WARN}[WARN] Cache discrepancy detected! OVAL cache ({oval_ts_str}) is {age_str} older than Web ({web_ts_str}).{CLR_RESET}")
        try:
            ans = input("Run manual OVAL sync now? [y/N]: ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            ans = "n"
            print()

        if ans in ("y", "yes"):
            sync_oval_files()
            return query(rel_arg, cve_arg, status_filter, as_json=as_json, with_mitigation=with_mitigation, allow_prompt=False)
        print()

    target_status = None
    if status_filter:
        norm_key = status_filter.lower().strip()
        target_status = STATUS_ALIASES.get(norm_key, status_filter.upper().strip())

    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    if major == "ALL":
        cur.execute("SELECT platform, package, status FROM cve_catalog WHERE cve=?", (cve,))
    else:
        cur.execute("SELECT platform, package, status FROM cve_catalog WHERE cve=? AND major=?", (cve, major))
    rows = cur.fetchall()
    conn.close()

    raw_status_map = {}
    if rows:
        hits = [r for r in rows if sp_regex.search(r[0])]
        for p, pkgs, st in hits:
            pkg_set = set(clean_pkg_name(item) for item in pkgs.split(", ") if clean_pkg_name(item))
            pkg_set = filter_packages_for_platform(p, pkg_set)
            if pkg_set:
                raw_status_map.setdefault(st, {}).setdefault(p, set()).update(pkg_set)

    if web_ok:
        for st, p_dict in web_map.items():
            if st.startswith("_") or not isinstance(p_dict, dict):
                continue
            for prod, pkgs in p_dict.items():
                filtered_pkgs = filter_packages_for_platform(prod, pkgs)
                if filtered_pkgs:
                    raw_status_map.setdefault(st, {}).setdefault(prod, set()).update(filtered_pkgs)
                    if st in ("AFFECTED", "IN QA", "IN PROGRESS", "NOT AFFECTED") and "RELEASED" in raw_status_map and prod in raw_status_map["RELEASED"]:
                        raw_status_map["RELEASED"][prod] -= filtered_pkgs
                        if not raw_status_map["RELEASED"][prod]:
                            del raw_status_map["RELEASED"][prod]
                    if st in ("IN QA", "IN PROGRESS") and "AFFECTED" in raw_status_map and prod in raw_status_map["AFFECTED"]:
                        promoted = {
                            ap for ap in raw_status_map["AFFECTED"][prod]
                            if ap in filtered_pkgs or any(ap.startswith(f"{wp}-") for wp in filtered_pkgs)
                        }
                        if promoted:
                            raw_status_map["AFFECTED"][prod] -= promoted
                            raw_status_map[st][prod].update(promoted)
                            if not raw_status_map["AFFECTED"][prod]:
                                del raw_status_map["AFFECTED"][prod]

        if web_all_prods and "AFFECTED" in raw_status_map:
            matching_web = [p for p in web_all_prods if sp_regex.search(p)]
            if not matching_web and sp:
                del raw_status_map["AFFECTED"]
            else:
                for p in list(raw_status_map["AFFECTED"].keys()):
                    if p not in web_all_prods:
                        del raw_status_map["AFFECTED"][p]
                if not raw_status_map["AFFECTED"]:
                    del raw_status_map["AFFECTED"]

    web_affected = web_map.get("AFFECTED", {}) if web_ok else {}
    rel_dict = raw_status_map.get("RELEASED", {})
    qa_dict = raw_status_map.get("IN QA", {})

    web_not_affected = web_map.get("NOT AFFECTED", {}) if web_ok else {}
    if "AFFECTED" in raw_status_map:
        for p in list(raw_status_map["AFFECTED"].keys()):
            explicit_web_aff = web_affected.get(p, set())
            if p in web_not_affected:
                raw_status_map["AFFECTED"][p] -= (web_not_affected[p] - explicit_web_aff)
            if p in rel_dict:
                raw_status_map["AFFECTED"][p] -= (rel_dict[p] - explicit_web_aff)
            if p in qa_dict:
                raw_status_map["AFFECTED"][p] -= (qa_dict[p] - explicit_web_aff)
            if not raw_status_map["AFFECTED"][p]:
                del raw_status_map["AFFECTED"][p]

        if not raw_status_map["AFFECTED"]:
            del raw_status_map["AFFECTED"]

    if web_ok and "NOT AFFECTED" in web_map:
        web_active_prods = (
            set(web_map.get("RELEASED", {}).keys())
            | set(web_map.get("IN QA", {}).keys())
            | set(web_map.get("IN PROGRESS", {}).keys())
            | set(web_map.get("AFFECTED", {}).keys())
        )
        na_base_versions = set()
        for na_prod in web_map["NOT AFFECTED"].keys():
            m_base = re.match(r'^SUSE Linux Enterprise Server (\d+(?: SP\d+)?)$', na_prod)
            if m_base:
                na_base_versions.add(m_base.group(1))
            if na_prod not in web_active_prods:
                for st_key in ("RELEASED", "IN QA", "IN PROGRESS", "AFFECTED"):
                    if st_key in raw_status_map and na_prod in raw_status_map[st_key]:
                        del raw_status_map[st_key][na_prod]
                        if not raw_status_map[st_key]:
                            del raw_status_map[st_key]

        for ver_str in na_base_versions:
            for st_key in ("RELEASED", "IN QA", "IN PROGRESS", "AFFECTED"):
                if st_key not in raw_status_map:
                    continue
                for p_name in list(raw_status_map[st_key].keys()):
                    if p_name not in web_active_prods and p_name.endswith(f" {ver_str}") and "SUSE Linux Enterprise" in p_name:
                        moved_pkgs = raw_status_map[st_key].pop(p_name)
                        raw_status_map.setdefault("NOT AFFECTED", {}).setdefault(p_name, set()).update(moved_pkgs)
                if not raw_status_map[st_key]:
                    del raw_status_map[st_key]

    pipeline_order = ["RELEASED", "IN QA", "IN PROGRESS", "AFFECTED"]
    for idx, higher_st in enumerate(pipeline_order):
        if higher_st not in raw_status_map:
            continue
        for lower_st in pipeline_order[idx + 1:]:
            if lower_st not in raw_status_map:
                continue
            for prod_k, higher_pkgs in raw_status_map[higher_st].items():
                if prod_k in raw_status_map[lower_st]:
                    raw_status_map[lower_st][prod_k] -= higher_pkgs
                    if not raw_status_map[lower_st][prod_k]:
                        del raw_status_map[lower_st][prod_k]
            if not raw_status_map[lower_st]:
                del raw_status_map[lower_st]

    if web_ok and "RELEASED" in raw_status_map:
        na_pkgs_by_ver = {}
        for na_p, na_pkgs in web_map.get("NOT AFFECTED", {}).items():
            m_v = re.search(r"\b(\d+(?: SP\d+)?)\b", na_p)
            if m_v:
                na_pkgs_by_ver.setdefault(m_v.group(1), set()).update(na_pkgs)
        for p_rel in list(raw_status_map["RELEASED"].keys()):
            if p_rel not in web_map.get("RELEASED", {}) and p_rel not in patch_map:
                m_v = re.search(r"\b(\d+(?: SP\d+)?)\b", p_rel)
                ver_na_pkgs = na_pkgs_by_ver.get(m_v.group(1), set()) if m_v else set()
                moved = raw_status_map["RELEASED"][p_rel] & ver_na_pkgs
                if moved:
                    raw_status_map["RELEASED"][p_rel] -= moved
                    raw_status_map.setdefault("NOT AFFECTED", {}).setdefault(p_rel, set()).update(moved)
                    if not raw_status_map["RELEASED"][p_rel]:
                        del raw_status_map["RELEASED"][p_rel]
        if not raw_status_map["RELEASED"]:
            del raw_status_map["RELEASED"]

    if "NOT AFFECTED" in raw_status_map:
        for p in list(raw_status_map["NOT AFFECTED"].keys()):
            if p in rel_dict:
                if web_ok and p not in web_map.get("RELEASED", {}) and p not in patch_map:
                    rel_dict[p] -= raw_status_map["NOT AFFECTED"][p]
                    if not rel_dict[p]:
                        del rel_dict[p]
                else:
                    raw_status_map["NOT AFFECTED"][p] -= rel_dict[p]
            if not raw_status_map["NOT AFFECTED"][p]:
                del raw_status_map["NOT AFFECTED"][p]
        if not rel_dict and "RELEASED" in raw_status_map:
            del raw_status_map["RELEASED"]
        if not raw_status_map["NOT AFFECTED"]:
            del raw_status_map["NOT AFFECTED"]

    all_affected_pkgs = set()
    for st_key in ("RELEASED", "IN QA", "IN PROGRESS", "AFFECTED"):
        for pkgs in raw_status_map.get(st_key, {}).values():
            all_affected_pkgs.update(pkgs)

    mitigation_data = None
    if True:  # Always compute remediation & mitigations for full default report
        suse_intel_meta = web_map.pop("_SUSE_INTEL", {})
        open_pkgs = set()
        target_vuln_pkgs = set()
        for st_k in ("RELEASED", "IN QA", "IN PROGRESS", "AFFECTED"):
            for p_k, pkgs_v in raw_status_map.get(st_k, {}).items():
                if major == "ALL" or sp_regex.search(p_k):
                    target_vuln_pkgs.update(pkgs_v)
                    if st_k != "RELEASED":
                        open_pkgs.update(pkgs_v)
        mitigation_data = generate_mitigation_report(cve, bugzilla_urls, target_vuln_pkgs, suse_intel_meta)
        target_has_released = any(
            (major == "ALL" or sp_regex.search(p_k))
            for p_k in list(raw_status_map.get("RELEASED", {}).keys()) + list(patch_map.keys())
        )
        if target_has_released:
            matched_patch_ids = []
            for p_k, p_list in patch_map.items():
                if major == "ALL" or sp_regex.search(p_k):
                    for p_item in p_list:
                        pid = (p_item.get("patch", "") if isinstance(p_item, dict) else str(p_item).split(" (")[0]).strip()
                        if pid and pid not in matched_patch_ids:
                            matched_patch_ids.append(pid)
            matched_patch_ids.sort(key=rank_suse_patch_id)
            needs_reboot = any(
                p.startswith(("kernel-", "glibc", "systemd", "xen", "dbus"))
                for p in target_vuln_pkgs
            )
            post_action = "REBOOT REQUIRED after patching" if needs_reboot else "Restart affected daemons (verify via 'zypper ps -s')"
            is_micro_target = major.startswith("MICRO") or (
                major == "ALL" and any("Micro" in k for k in patch_map.keys()) and not any("Server" in k for k in patch_map.keys())
            )
            if is_micro_target:
                rem_cmd = f"transactional-update patch && reboot  # Or: transactional-update pkg in -t patch {' '.join(matched_patch_ids[:4])}" if matched_patch_ids else "transactional-update patch && reboot"
                rem_title = f"Apply released SL Micro transactional patch for {cve} (REBOOT REQUIRED)"
            else:
                rem_cmd = f"zypper refresh && zypper patch --cve={cve} && zypper ps -s" + (f"  # Explicit patch IDs: zypper in -t patch {' '.join(matched_patch_ids[:4])}" if matched_patch_ids else "")
                rem_title = f"Apply released SUSE security patch for {cve} ({post_action})"
            mitigation_data["remediation"] = [{
                "title": rem_title,
                "cmd": rem_cmd
            }]

    lifecycle_map = load_sles_lifecycle()
    affected_releases = summarize_affected_sles_releases(cve, web_all_prods, web_map)

    active_supported_releases = []
    ltss_releases = []
    eol_releases = []
    release_lifecycle_details = {}

    for r_tag in affected_releases:
        lc = evaluate_release_lifecycle(r_tag, lifecycle_map)
        release_lifecycle_details[r_tag] = lc
        if lc["state"] == "GENERAL_SUPPORT":
            active_supported_releases.append(r_tag)
        elif lc["state"] == "LTSS_ONLY":
            ltss_releases.append(f"{r_tag} (LTSS until {lc['ltss_eol']})")
        elif lc["state"] == "EOL":
            eol_releases.append(r_tag)
        else:
            active_supported_releases.append(r_tag)

    target_sles_tag = None
    if major != "ALL":
        if major.startswith("MICRO") and sp:
            target_sles_tag = f"SL Micro {major.replace('MICRO', '')}.{sp}"
        elif major == "16":
            target_sles_tag = f"SLES 16.{sp if sp else '0'}"
        elif sp:
            target_sles_tag = f"SLES {major} SP{sp}"
    target_lifecycle = evaluate_release_lifecycle(target_sles_tag, lifecycle_map) if target_sles_tag else None

    target_has_patches = any(
        (major == "ALL" or sp_regex.search(p_k))
        for p_k in patch_map.keys()
    )
    target_has_rel_map = any(
        (major == "ALL" or sp_regex.search(p_k))
        for p_k in raw_status_map.get("RELEASED", {}).keys()
    )
    has_released = target_has_rel_map or target_has_patches
    has_qa = any((major == "ALL" or sp_regex.search(p_k)) for p_k in raw_status_map.get("IN QA", {}).keys())
    has_in_progress = any((major == "ALL" or sp_regex.search(p_k)) for p_k in raw_status_map.get("IN PROGRESS", {}).keys())
    has_unpatched = any(
        (major == "ALL" or sp_regex.search(p_k))
        for st_u in ("AFFECTED", "WONT FIX")
        for p_k in raw_status_map.get(st_u, {}).keys()
    )
    for st_web, prod_dict in web_map.items():
        if st_web.startswith("_") or st_web in ("RELEASED", "NOT AFFECTED") or not isinstance(prod_dict, dict):
            continue
        for p_web in prod_dict.keys():
            if major == "ALL" or sp_regex.search(p_web):
                if st_web == "IN QA":
                    has_qa = True
                elif st_web == "IN PROGRESS":
                    has_in_progress = True
                else:
                    has_unpatched = True

    if not target_has_patches and mitigation_data and "remediation" in mitigation_data:
        del mitigation_data["remediation"]

    if has_released and not has_qa and not has_in_progress and not has_unpatched:
        triage_status = "PATCHED (Patches released)"
    elif has_released and (has_qa or has_in_progress or has_unpatched):
        triage_status = "PARTIALLY PATCHED (Patches available for some releases/packages; others pending or unpatched)"
        if mitigation_data is not None:
            mitigation_data["partial_patch"] = True
    elif has_qa:
        triage_status = "IN QA (Patches in testing — mitigation recommended until release)"
    elif has_in_progress:
        triage_status = "IN PROGRESS (SUSE engineering actively building fix — mitigation recommended)"
    elif has_unpatched:
        triage_status = "UNPATCHED (No patches released yet — mitigation required)"
    else:
        triage_status = "NOT AFFECTED / NO OPEN VULNERABILITY"

    def _extract_rel_tag(text: str):
        m_mic = re.search(r"(?:Enterprise|Linux)\s+Micro\s+([56])\.(\d+)\b", text, re.IGNORECASE)
        if m_mic:
            return f"SL Micro {m_mic.group(1)}.{m_mic.group(2)}"
        low = text.lower()
        if "opensuse" in low or low.startswith("container ") or low.startswith("image "):
            return None
        m = re.search(r'(?:suse linux enterprise|sle[s]?)[^0-9]*\b(12|15|16)(?:[.\s-]*(?:sp|service pack)?\s*(\d+))?', low)
        if not m:
            return None
        maj, minor = m.group(1), m.group(2)
        if maj == "16":
            return f"SLES 16.{minor if minor else '0'}"
        if minor:
            return f"SLES {maj} SP{minor}"
        return f"SLES {maj}"

    def _compact_release_tags(tags: set) -> list:
        # Group consecutive SP/minor versions (e.g., SLES 15 SP1..SP5 -> SLES 15 SP1-SP5)
        groups = {}
        others = set()
        for t in tags:
            m = re.match(r'^(SLES (?:12|15) SP)(\d+)$', t)
            if m:
                groups.setdefault(m.group(1), []).append(int(m.group(2)))
                continue
            m2 = re.match(r'^(SL Micro [56]\.)(\d+)$', t)
            if m2:
                groups.setdefault(m2.group(1), []).append(int(m2.group(2)))
                continue
            others.add(t)
        out = []
        for prefix in sorted(groups.keys()):
            nums = sorted(set(groups[prefix]))
            start = prev = nums[0]
            for n in nums[1:] + [None]:
                if n is not None and n == prev + 1:
                    prev = n
                else:
                    if prev - start >= 2:
                        out.append(f"{prefix}{start}-{prefix.split()[-1]}{prev}" if "SP" in prefix else f"{prefix}{start}-{prefix.split()[-1]}{prev}")
                    elif prev > start:
                        out.append(f"{prefix}{start}")
                        out.append(f"{prefix}{prev}")
                    else:
                        out.append(f"{prefix}{start}")
                    if n is not None:
                        start = prev = n
        out.extend(sorted(others))
        return sorted(out)

    rel_released_tags = set()
    rel_open_tags = set()
    rel_not_aff_tags = set()

    for p_k in list(raw_status_map.get("RELEASED", {}).keys()) + list(patch_map.keys()):
        tg = _extract_rel_tag(p_k)
        if tg:
            rel_released_tags.add(tg)

    for st_k in ("IN QA", "IN PROGRESS", "AFFECTED"):
        for p_k in raw_status_map.get(st_k, {}).keys():
            tg = _extract_rel_tag(p_k)
            if tg:
                rel_open_tags.add(tg)

    for p_k in raw_status_map.get("NOT AFFECTED", {}).keys():
        tg = _extract_rel_tag(p_k)
        if tg:
            rel_not_aff_tags.add(tg)

    for r_tag in affected_releases:
        if r_tag not in rel_released_tags and r_tag not in rel_open_tags:
            rel_open_tags.add(r_tag)

    partial_releases_set = rel_released_tags & rel_open_tags
    patched_releases_list = _compact_release_tags(rel_released_tags - rel_open_tags)
    partially_patched_releases_list = _compact_release_tags(partial_releases_set)
    open_releases_list = _compact_release_tags(rel_open_tags - partial_releases_set)
    not_affected_releases_list = _compact_release_tags(rel_not_aff_tags - set(affected_releases) - rel_released_tags - rel_open_tags)

    meta_payload = {
        "oval_timestamp": oval_ts_str,
        "web_last_modified": web_ts_str,
        "stale_warning": is_stale,
        "affected_sles_releases": affected_releases,
        "patched_releases": patched_releases_list,
        "partially_patched_releases": partially_patched_releases_list,
        "open_releases": open_releases_list,
        "not_affected_releases": not_affected_releases_list,
        "affected_sles_lifecycle": release_lifecycle_details,
        "target_lifecycle": target_lifecycle,
        "triage_status": triage_status
    }

    if config_mode == "salt":
        print(render_salt_config(cve, rel_arg, mitigation_data or {}, force_workaround=force_workaround))
        sys.exit(0)
    elif config_mode == "ansible":
        print(render_ansible_config(cve, rel_arg, mitigation_data or {}, force_workaround=force_workaround))
        sys.exit(0)

    if not as_json and view_mode in ("mitigate", "remediate"):
        label = "MITIGATIONS (COMPENSATING WORKAROUNDS)" if view_mode == "mitigate" else "REMEDIATION (VENDOR PATCH)"
        print(f"\n[{cve} | {rel_arg.upper()} | {label}]")
        if mitigation_data:
            print_mitigation_block(mitigation_data, view_mode=view_mode)
        sys.exit(0)

    if not raw_status_map:
        if as_json:
            payload = {
                "cve": cve,
                "release": rel_arg,
                "status": "NOT_AFFECTED_OR_UNKNOWN",
                "meta": meta_payload,
                "results": {},
                "patches": {}
            }
            if mitigation_data:
                payload["mitigation"] = mitigation_data
            print(json.dumps(payload, indent=2))
        else:
            print(f"{CLR_DIM}[SYNC] OVAL: {oval_ts_str} | WEB: {web_ts_str}{CLR_RESET}")
            print(f"NOT AFFECTED / UNKNOWN (No entries found for {cve} on {rel_arg})")
            if mitigation_data:
                print_mitigation_block(mitigation_data)
        sys.exit(0)

    output_dict = {}
    if target_status:
        keys_to_check = [target_status]
        if target_status == "IN PROGRESS":
            keys_to_check = ["IN QA", "AFFECTED"]

        for k in keys_to_check:
            if k in raw_status_map and raw_status_map[k]:
                output_dict[k] = {
                    p: sorted(list(pkgs)) for p, pkgs in sorted(raw_status_map[k].items()) if pkgs
                }

        if not output_dict:
            if as_json:
                payload = {
                    "cve": cve,
                    "release": rel_arg,
                    "filter": target_status,
                    "status": "NONE",
                    "meta": meta_payload,
                    "results": {},
                    "patches": {}
                }
                if mitigation_data:
                    payload["mitigation"] = mitigation_data
                print(json.dumps(payload, indent=2))
            else:
                print(f"{CLR_DIM}[SYNC] OVAL: {oval_ts_str} | WEB: {web_ts_str}{CLR_RESET}")
                print(f"NONE (No packages with status '{target_status}' for {cve} on {rel_arg})")
                if mitigation_data:
                    print_mitigation_block(mitigation_data)
            sys.exit(1)

    else:
        for st in ["RELEASED", "IN QA", "IN PROGRESS", "AFFECTED", "NOT AFFECTED", "WONT FIX"]:
            if st in raw_status_map and raw_status_map[st]:
                filtered_st = {
                    p: sorted(list(pkgs))
                    for p, pkgs in sorted(raw_status_map[st].items())
                    if pkgs and (major == "ALL" or sp_regex.search(p))
                }

                if filtered_st:
                    output_dict[st] = filtered_st

    sorted_patches = {k: patch_map[k] for k in sorted(patch_map.keys())}

    if as_json:
        payload = {
            "cve": cve,
            "release": rel_arg,
            "major": major,
            "sp": sp,
            "filter": target_status if target_status else "ALL",
            "meta": meta_payload,
            "results": output_dict,
            "patches": sorted_patches
        }
        if mitigation_data:
            payload["mitigation"] = mitigation_data
        print(json.dumps(payload, indent=2))
        sys.exit(0)

    c_rel = PALETTE.get("RELEASED", {}).get("pkg", "")
    c_qa = PALETTE.get("IN QA", {}).get("pkg", "")
    c_aff = PALETTE.get("AFFECTED", {}).get("pkg", "")
    c_aff_b = PALETTE.get("AFFECTED", {}).get("header", "")
    c_na = PALETTE.get("NOT AFFECTED", {}).get("pkg", "")

    if triage_status.startswith("PATCHED") or triage_status.startswith("NOT AFFECTED"):
        st_color = PALETTE.get("RELEASED", {}).get("header", "")
    elif triage_status.startswith("PARTIALLY PATCHED") or triage_status.startswith("IN QA"):
        st_color = PALETTE.get("IN QA", {}).get("header", "")
    elif triage_status.startswith("IN PROGRESS"):
        st_color = CLR_CYAN
    else:
        st_color = c_aff_b

    print(f"{CLR_DIM}[SYNC] OVAL: {oval_ts_str} | WEB: {web_ts_str}{CLR_RESET}\n")
    r_single = format_triage_row({
        "cve": cve,
        "meta": meta_payload,
        "patches": sorted_patches,
        "mitigation": mitigation_data or {},
    }, rel_arg=rel_arg)
    w_cve = max(len("CVE"), len(r_single["cve"]))
    w_st = max(len("STATUS"), len(r_single["status"]))
    w_sev = max(len("SEVERITY"), len(r_single["severity"]))
    w_lc = max(len("LIFECYCLE"), len(r_single["lifecycle"]))
    tbl_hdr = f"  {'CVE':<{w_cve}}  {'STATUS':<{w_st}}  {'SEVERITY':<{w_sev}}  {'LIFECYCLE':<{w_lc}}  PATCHES / ACTION"
    print(f"{CLR_BOLD}{tbl_hdr}{CLR_RESET}")
    print("  " + "-" * (len(tbl_hdr) - 2))
    print(f"  {r_single['cve']:<{w_cve}}  {st_color}{r_single['status']:<{w_st}}{CLR_RESET}  {r_single['severity']:<{w_sev}}  {r_single['lifecycle']:<{w_lc}}  {r_single['action']}\n")
    print(f"{CLR_MAG}[EXECUTIVE TRIAGE SUMMARY]{CLR_RESET}")
    if affected_releases:
        if active_supported_releases:
            print(f"  {CLR_BOLD}Affected (General Support) :{CLR_RESET} {c_aff}{', '.join(active_supported_releases)}{CLR_RESET}")
        if ltss_releases:
            print(f"  {CLR_BOLD}Affected (LTSS Required)   :{CLR_RESET} {c_qa}{', '.join(ltss_releases)}{CLR_RESET}")
        if eol_releases:
            print(f"  {CLR_BOLD}Affected (End-of-Life)     :{CLR_RESET} {c_aff_b}{', '.join(eol_releases)}{CLR_RESET}")
    else:
        print(f"  {CLR_BOLD}Affected SLES Versions     :{CLR_RESET} {c_na}None detected across SLES 12/15/16{CLR_RESET}")

    if major == "ALL":
        if patched_releases_list:
            print(f"  {CLR_BOLD}Patched Releases           :{CLR_RESET} {c_rel}{', '.join(patched_releases_list)}{CLR_RESET}")
        if partially_patched_releases_list:
            print(f"  {CLR_BOLD}Partially Patched Releases :{CLR_RESET} {c_qa}{', '.join(partially_patched_releases_list)}{CLR_RESET}")
        if open_releases_list:
            print(f"  {CLR_BOLD}Open / Unpatched Releases  :{CLR_RESET} {c_aff}{', '.join(open_releases_list)}{CLR_RESET}")
    if not_affected_releases_list:
        print(f"  {CLR_BOLD}Not Affected Releases      :{CLR_RESET} {c_na}{', '.join(not_affected_releases_list)}{CLR_RESET}")

    if target_lifecycle and target_lifecycle["state"] != "UNKNOWN":
        lc_color = c_aff_b if target_lifecycle["state"] == "EOL" else (CLR_WARN if target_lifecycle["state"] == "LTSS_ONLY" else c_rel)
        print(f"  {CLR_BOLD}Target Lifecycle ({rel_arg})   :{CLR_RESET} {lc_color}{target_lifecycle['label']}{CLR_RESET}")

    print(f"  {CLR_BOLD}Release Status ({rel_arg})     :{CLR_RESET} {st_color}{triage_status}{CLR_RESET}")

    if target_lifecycle and target_lifecycle["state"] == "EOL":
        print(f"  {c_aff_b}[!] LIFECYCLE ALERT        : {target_sles_tag} is End-of-Life — no upstream patches will be provided! Upgrade or apply mitigations.{CLR_RESET}")
    elif not has_released and (has_unpatched or has_in_progress or has_qa) and not with_mitigation:
        print(f"  {CLR_WARN}Recommended Next Step      :{CLR_RESET} Run with {CLR_CYAN}--mitigate{CLR_RESET} for immediate workarounds & advisory intel")
    print()

    for st, p_dict in output_dict.items():
        colors = PALETTE.get(st, {"header": CLR_BOLD, "pkg": ""})
        h_color = colors.get("header", CLR_BOLD)
        p_color = colors.get("pkg", "")

        print(f"{h_color}[{st}]{CLR_RESET}")
        for p, pkgs in p_dict.items():
            if pkgs:
                pkgs_formatted = f"{p_color}{', '.join(pkgs)}{CLR_RESET}"
                print(f"  {CLR_DIM}-{CLR_RESET} {CLR_BOLD}{p}{CLR_RESET} -> {pkgs_formatted}")
        print()

    if sorted_patches and (not target_status or target_status == "RELEASED"):
        print(f"{CLR_CYAN}[PATCHES]{CLR_RESET}")
        for prod, p_list in sorted_patches.items():
            formatted_entries = [f"{item['patch']} ({','.join(item['archs'])})" for item in p_list]
            print(f"  {CLR_DIM}-{CLR_RESET} {CLR_BOLD}{prod}{CLR_RESET} -> {', '.join(formatted_entries)}")
        print()

    if mitigation_data:
        print_mitigation_block(mitigation_data)



def _emit_salt_suggestion_states(
    cve: str,
    sugs: list,
    lines: list,
    state: dict,
    prefix_batch: bool = False,
) -> int:
    """Render source-attributed, idempotent SaltStack states for compensating workarounds."""
    safe_cve = re.sub(r"[^A-Za-z0-9_]", "_", cve.lower())
    default_urls = [
        f"https://www.suse.com/security/cve/{cve}.html",
        f"https://nvd.nist.gov/vuln/detail/{cve}",
    ]
    step_idx = 0

    for s in sugs:
        cmd = s.get("cmd", "").strip()
        raw_title = s.get("title", "").strip()
        attr = s.get("source_attribution") or "SUSE / NVD Security Hardening Guidance"
        urls = s.get("source_urls") or default_urls

        if "No SLES packages affected" in raw_title:
            lines.append(f"# {raw_title}")
            continue

        lines.append(f"# [Due to {attr}] {raw_title}")
        lines.append(f"# Source / Verify: {' | '.join(urls)}")
        if s.get("rollback"):
            lines.append(f"# Rollback (post-patch): {s['rollback']}")

        if not cmd or cmd.startswith("#") or cmd.startswith("true"):
            lines.append("# Action: Manual review required (no automated command)")
            lines.append("")
            continue

        step_idx += 1
        sid = f"{safe_cve}_step_{step_idx}"

        # 1. nftables ruleset mitigation (e.g. RHSB-2026-016 / IPv4 TCP IP-options filter)
        if "nft -f -" in cmd and "table inet " in cmd:
            m_tbl = re.search(r"table inet ([A-Za-z0-9_]+)", cmd)
            tbl_name = m_tbl.group(1) if m_tbl else safe_cve
            m_eof = re.search(r"<<'EOF'\n(.*?)\nEOF", cmd, re.S)
            nft_body = m_eof.group(1).strip() if m_eof else (
                f"add table inet {tbl_name}\n"
                f"delete table inet {tbl_name}\n"
                f"table inet {tbl_name} {{\n"
                f"  chain input {{\n"
                f"    type filter hook input priority -310; policy accept;\n"
                f"    ip protocol tcp ip hdrlength > 5 counter drop\n"
                f"  }}\n"
                f"}}"
            )
            nft_path = f"/etc/nftables.d/{tbl_name}.nft"
            lines.extend([
                f"{sid}_nftables_rule:",
                "  file.managed:",
                f"    - name: {nft_path}",
                "    - user: root",
                "    - group: root",
                "    - mode: '0644'",
                "    - makedirs: True",
                "    - contents: |",
                f"        # [Due to {attr}] {raw_title}",
                f"        # Source / Verify: {' | '.join(urls)}",
            ])
            for nln in nft_body.splitlines():
                lines.append(f"        {nln}")
            lines.extend([
                "",
                f"{sid}_nftables_apply:",
                "  cmd.run:",
                f"    - name: nft --file {nft_path}",
                "    - onchanges:",
                f"      - file: {sid}_nftables_rule",
                ""
            ])
            continue

        # 2. GRUB2 configuration permissions & Secure Boot verification
        if "chmod 600 /boot/grub2/grub.cfg" in cmd:
            lines.extend([
                f"{sid}_grub_cfg_perms:",
                "  file.managed:",
                "    - name: /boot/grub2/grub.cfg",
                "    - user: root",
                "    - group: root",
                "    - mode: '0600'",
                "    - create: False",
                "    - onlyif: test -f /boot/grub2/grub.cfg",
                "",
                f"{sid}_verify_secure_boot:",
                "  cmd.run:",
                "    - name: mokutil --sb-state || true",
                ""
            ])
            continue

        # 3. systemd / profile JVM flags
        if "DefaultEnvironment=" in cmd and "99-cve-java.conf" in cmd:
            m = re.search(r'JDK_JAVA_OPTIONS=([^"\\]+)', cmd)
            flags = m.group(1) if m else "-XX:-UseBASE64Intrinsics"
            if not state.get("emitted_systemd"):
                dir_id = "cve_batch_systemd_dir" if prefix_batch else f"{sid}_systemd_dir"
                drop_id = "cve_batch_systemd_java_dropin" if prefix_batch else f"{sid}_systemd_java_dropin"
                lines.extend([
                    f"{dir_id}:",
                    "  file.directory:",
                    "    - name: /etc/systemd/system.conf.d",
                    "    - makedirs: True",
                    "",
                    f"{drop_id}:",
                    "  file.managed:",
                    "    - name: /etc/systemd/system.conf.d/99-cve-java.conf",
                    "    - contents: |",
                    "        [Manager]",
                    f'        DefaultEnvironment="JDK_JAVA_OPTIONS={flags}"',
                    "    - require:",
                    f"      - file: {dir_id}",
                    ""
                ])
                state["emitted_systemd"] = True
                state["systemd_dropin_id"] = drop_id
            if not state.get("emitted_profile"):
                prof_id = "cve_batch_profile_java_dropin" if prefix_batch else f"{sid}_profile_java_dropin"
                lines.extend([
                    f"{prof_id}:",
                    "  file.managed:",
                    "    - name: /etc/profile.d/cve-java.sh",
                    "    - mode: '0644'",
                    "    - contents: |",
                    f'        export JDK_JAVA_OPTIONS="{flags}"',
                    ""
                ])
                state["emitted_profile"] = True
            continue

        # 4. Tomcat JVM drop-in
        if "/etc/tomcat/conf.d" in cmd:
            if not state.get("emitted_tomcat"):
                m = re.search(r'JAVA_OPTS="\$\{JAVA_OPTS\} ([^"]+)"', cmd)
                flags = m.group(1) if m else "-XX:-UseBASE64Intrinsics"
                tom_id = "cve_batch_tomcat_dropin" if prefix_batch else f"{sid}_tomcat_dropin"
                lines.extend([
                    f"{tom_id}:",
                    "  file.managed:",
                    "    - name: /etc/tomcat/conf.d/99-cve-mitigation.conf",
                    "    - contents: |",
                    f'        JAVA_OPTS="${{JAVA_OPTS}} {flags}"',
                    "    - onlyif: test -d /etc/tomcat/conf.d",
                    ""
                ])
                state["emitted_tomcat"] = True
                state["tomcat_dropin_id"] = tom_id
            continue

        # 5. OpenSSH LoginGraceTime drop-in
        if "LoginGraceTime 0" in cmd and "/etc/ssh/sshd_config.d/" in cmd:
            lines.extend([
                f"{sid}_sshd_mitigation:",
                "  file.managed:",
                "    - name: /etc/ssh/sshd_config.d/99-cve-mitigation.conf",
                "    - user: root",
                "    - group: root",
                "    - mode: '0644'",
                "    - makedirs: True",
                "    - check_cmd: /usr/sbin/sshd -t -f",
                "    - contents: |",
                f"        # [Due to {attr}] {raw_title}",
                "        LoginGraceTime 0",
                "",
                f"{sid}_sshd_reload:",
                "  service.running:",
                "    - name: sshd",
                "    - reload: True",
                "    - watch:",
                f"      - file: {sid}_sshd_mitigation",
                ""
            ])
            continue

        # 6. Kernel module modprobe blacklist
        if "/etc/modprobe.d/" in cmd and "install " in cmd and "/bin/true" in cmd:
            m_dst = re.search(r"(/etc/modprobe\.d/[A-Za-z0-9_.\-]+\.conf)", cmd)
            dst_file = m_dst.group(1) if m_dst else "/etc/modprobe.d/cve-mitigation.conf"
            mods = re.findall(r"install\s+([A-Za-z0-9_\-]+)\s+/bin/true", cmd)
            if mods:
                lines.extend([
                    f"{sid}_modprobe_blacklist:",
                    "  file.managed:",
                    f"    - name: {dst_file}",
                    "    - mode: '0644'",
                    "    - makedirs: True",
                    "    - contents: |",
                    f"        # [Due to {attr}] {raw_title}",
                ])
                for mod in mods:
                    lines.append(f"        install {mod} /bin/true")
                lines.append("")
                for mod in mods:
                    safe_mod = re.sub(r"[^A-Za-z0-9_]", "_", mod)
                    lines.extend([
                        f"{sid}_unload_{safe_mod}:",
                        "  kmod.absent:",
                        f"    - name: {mod}",
                        ""
                    ])
                continue

        # 7. sysctl kernel hardening (preserving custom /etc/sysctl.d/*.conf path if specified)
        if cmd.startswith("sysctl -w "):
            m_sc = re.search(r"(/etc/sysctl\.d/[A-Za-z0-9_.\-]+\.conf)", cmd)
            sysctl_file = m_sc.group(1) if m_sc else "/etc/sysctl.d/99-cve-mitigation.conf"
            kv_tokens = [tok for tok in cmd.split("sysctl -w ", 1)[1].split("&&")[0].strip().split() if "=" in tok]
            for idx_kv, kv in enumerate(kv_tokens, 1):
                k_name, k_val = [x.strip() for x in kv.split("=", 1)]
                if (k_name, k_val) in state["seen_sysctls"]:
                    continue
                state["seen_sysctls"].add((k_name, k_val))
                state_id = f"{sid}_sysctl_{idx_kv}" if prefix_batch else f"{sid}_sysctl"
                lines.extend([
                    f"{state_id}:",
                    "  sysctl.present:",
                    f"    - name: {k_name}",
                    f"    - value: '{k_val}'",
                    f"    - config: {sysctl_file}",
                    ""
                ])
            continue

        # 8. Active Java process inspection
        if "ps -ef | grep" in cmd:
            lines.extend([
                f"{sid}_verify_java_flags:",
                "  cmd.run:",
                "    - name: ps -ef | grep -E '[j]ava' || true",
                ""
            ])
            continue

        # 9. Generic multi-line-safe cmd.run fallback
        if "\n" in cmd:
            lines.extend([
                f"{sid}_exec:",
                "  cmd.run:",
                "    - name: |",
            ])
            for cln in cmd.splitlines():
                lines.append(f"        {cln}")
            lines.append("")
        else:
            lines.extend([
                f"{sid}_exec:",
                "  cmd.run:",
                f"    - name: {cmd}",
                ""
            ])

    return step_idx


def _append_salt_handlers(lines: list, state: dict, prefix_id: str) -> None:
    if state.get("systemd_dropin_id"):
        lines.extend([
            f"{prefix_id}_systemd_daemon_reload:",
            "  cmd.run:",
            "    - name: systemctl daemon-reload",
            "    - onchanges:",
            f"      - file: {state['systemd_dropin_id']}",
            ""
        ])
    if state.get("tomcat_dropin_id"):
        lines.extend([
            f"{prefix_id}_restart_java_services:",
            "  cmd.run:",
            "    - name: spacewalk-service restart 2>/dev/null || systemctl try-restart tomcat taskomatic rhn-search",
            "    - onchanges:",
            f"      - file: {state['tomcat_dropin_id']}",
            ""
        ])


def render_salt_config(cve: str, rel_arg: str, mitigation_data: dict, force_workaround: bool = False) -> str:
    safe_cve = re.sub(r'[^A-Za-z0-9_]', '_', cve.lower())
    cvss = mitigation_data.get("cvss", "N/A")
    vec = mitigation_data.get("attack_vector", "UNKNOWN")
    kev = "YES (CISA KEV)" if (mitigation_data.get("cisa_kev") or {}).get("known_exploited") else "No"
    bz_list = mitigation_data.get("bugzilla") or []
    lines = [
        f"# Auto-generated SaltStack State for {cve} (Target: {rel_arg})",
        f"# CVSS    : {cvss} | Vector: {vec} | CISA KEV: {kev}",
        f"# Advisory: https://www.suse.com/security/cve/{cve}.html | https://nvd.nist.gov/vuln/detail/{cve}",
    ]
    if bz_list:
        lines.append(f"# Bugzilla: {', '.join(bz_list[:4])}")
    lines.extend([
        f"# Save to : /srv/salt/{safe_cve}.sls  (or /srv/salt/{cve}.sls -> state.apply {cve})",
        f"# Dry-run : salt -G 'os_family:Suse' state.apply {safe_cve} test=True",
        f"# Apply   : salt -G 'os_family:Suse' state.apply {safe_cve}",
        "#",
        "# DISCLAIMER: Provided as-is without warranty. Service names, config paths (Tomcat/systemd/wrapper),",
        "# and runtime flags may vary across SLES versions, SUMA/Uyuni, or custom setups. Test before production rollout.",
        ""
    ])

    rems = mitigation_data.get("remediation") or []
    sugs = mitigation_data.get("suggestions") or []

    if rems and not force_workaround:
        rem = rems[0]
        cmd = rem["cmd"].split("  #")[0].strip()
        is_micro = "transactional-update" in cmd
        lines.append(f"# [Due to Official SUSE Vendor Patch] {rem.get('title', 'Apply vendor security update')}")
        lines.append(f"# Source / Verify: https://www.suse.com/security/cve/{cve}.html")
        lines.extend([
            f"{safe_cve}_refresh_and_patch:",
            "  cmd.run:",
            f"    - name: {cmd}",
            (
                f"    - onlyif: zypper --non-interactive list-patches --cve={cve} | grep -q 'Needed'"
                if not is_micro
                else "    - onlyif: which transactional-update >/dev/null 2>&1"
            ),
            ""
        ])
        if "REBOOT REQUIRED" in rem.get("title", ""):
            lines.extend([
                f"{safe_cve}_reboot_notice:",
                "  test.show_notification:",
                f'    - text: "Patch for {cve} applied — schedule system reboot to activate updated kernel/core libraries."',
                "    - require:",
                f"      - cmd: {safe_cve}_refresh_and_patch",
                ""
            ])
        return "\n".join(lines)

    state = {"seen_sysctls": set()}
    step_idx = _emit_salt_suggestion_states(cve, sugs, lines, state, prefix_batch=False)
    _append_salt_handlers(lines, state, safe_cve)

    if step_idx == 0:
        noop_msg = sugs[0].get("title", f"No actionable SLES workaround required for {cve}").replace('"', "'") if sugs else f"No actionable SLES workaround required for {cve}"
        lines.extend([
            f"{safe_cve}_no_action_required:",
            "  test.succeed_without_changes:",
            f'    - name: "{noop_msg}"',
            ""
        ])

    return "\n".join(lines)


def _emit_ansible_suggestion_tasks(
    cve: str,
    sugs: list,
    lines: list,
    state: dict,
    prefix_cve: bool = False,
) -> int:
    """Render source-attributed, idempotent Ansible tasks for compensating workarounds."""
    safe_cve = re.sub(r"[^A-Za-z0-9_]", "_", cve.lower())
    default_urls = [
        f"https://www.suse.com/security/cve/{cve}.html",
        f"https://nvd.nist.gov/vuln/detail/{cve}",
    ]
    task_idx = 0

    for s in sugs:
        cmd = s.get("cmd", "").strip()
        raw_title = s.get("title", "").strip()
        title = raw_title.replace('"', '\\"')
        attr = s.get("source_attribution") or "SUSE / NVD Security Hardening Guidance"
        urls = s.get("source_urls") or default_urls
        cve_tag = f"[{cve}] " if prefix_cve else ""

        if "No SLES packages affected" in raw_title:
            lines.append(f"    # {raw_title}")
            continue

        lines.append(f"    # [Due to {attr}] {raw_title}")
        lines.append(f"    # Source / Verify: {' | '.join(urls)}")
        if s.get("rollback"):
            lines.append(f"    # Rollback (post-patch): {s['rollback']}")

        if not cmd or cmd.startswith("#") or cmd.startswith("true"):
            lines.append("    # Action: Manual review required (no automated command)")
            lines.append("")
            continue

        task_idx += 1

        # 1. nftables ruleset mitigation (e.g. RHSB-2026-016 / IPv4 TCP IP-options filter)
        if "nft -f -" in cmd and "table inet " in cmd:
            m_tbl = re.search(r"table inet ([A-Za-z0-9_]+)", cmd)
            tbl_name = m_tbl.group(1) if m_tbl else safe_cve
            m_eof = re.search(r"<<'EOF'\n(.*?)\nEOF", cmd, re.S)
            nft_body = m_eof.group(1).strip() if m_eof else (
                f"add table inet {tbl_name}\n"
                f"delete table inet {tbl_name}\n"
                f"table inet {tbl_name} {{\n"
                f"  chain input {{\n"
                f"    type filter hook input priority -310; policy accept;\n"
                f"    ip protocol tcp ip hdrlength > 5 counter drop\n"
                f"  }}\n"
                f"}}"
            )
            nft_path = f"/etc/nftables.d/{tbl_name}.nft"
            lines.extend([
                f'    - name: "{cve_tag}[{attr}] Ensure /etc/nftables.d directory exists"',
                "      ansible.builtin.file:",
                "        path: /etc/nftables.d",
                "        state: directory",
                "        mode: '0755'",
                "      when: ansible_facts['os_family'] == 'Suse'",
                "",
                f'    - name: "{cve_tag}[{attr}] Deploy nftables mitigation ruleset ({nft_path})"',
                "      ansible.builtin.copy:",
                f"        dest: {nft_path}",
                "        mode: '0644'",
                "        backup: true",
                "        content: |",
                f"          # [Due to {attr}] {raw_title}",
                f"          # Source / Verify: {' | '.join(urls)}",
            ])
            for nln in nft_body.splitlines():
                lines.append(f"          {nln}")
            lines.extend([
                f"      register: nft_rule_{tbl_name}",
                "      when: ansible_facts['os_family'] == 'Suse'",
                "",
                f'    - name: "{cve_tag}[{attr}] Validate and load nftables mitigation table ({tbl_name})"',
                "      ansible.builtin.command:",
                f"        cmd: nft --file {nft_path}",
                f"      when: ansible_facts['os_family'] == 'Suse' and (nft_rule_{tbl_name} is changed or not ansible_check_mode)",
                "      changed_when: false",
                ""
            ])
            continue

        # 2. GRUB2 configuration permissions & Secure Boot verification
        if "chmod 600 /boot/grub2/grub.cfg" in cmd:
            lines.extend([
                f'    - name: "{cve_tag}[{attr}] Restrict write access to /boot/grub2/grub.cfg (0600)"',
                "      ansible.builtin.file:",
                "        path: /boot/grub2/grub.cfg",
                "        owner: root",
                "        group: root",
                "        mode: '0600'",
                "      when: ansible_facts['os_family'] == 'Suse'",
                "",
                f'    - name: "{cve_tag}[{attr}] Verify UEFI Secure Boot lockdown state (mokutil)"',
                "      ansible.builtin.command:",
                "        cmd: mokutil --sb-state",
                f"      register: mokutil_sb_{safe_cve}",
                "      changed_when: false",
                "      failed_when: false",
                "      when: ansible_facts['os_family'] == 'Suse'",
                ""
            ])
            continue

        # 3. systemd / profile JVM flags
        if "DefaultEnvironment=" in cmd and "99-cve-java.conf" in cmd:
            m = re.search(r'JDK_JAVA_OPTIONS=([^"\\]+)', cmd)
            flags = m.group(1) if m else "-XX:-UseBASE64Intrinsics"
            if not state.get("emitted_systemd"):
                lines.extend([
                    f'    - name: "{cve_tag}[{attr}] Ensure /etc/systemd/system.conf.d directory exists"',
                    "      ansible.builtin.file:",
                    "        path: /etc/systemd/system.conf.d",
                    "        state: directory",
                    "        mode: '0755'",
                    "",
                    f'    - name: "{cve_tag}[{attr}] Configure systemd DefaultEnvironment JVM mitigation ({flags})"',
                    "      ansible.builtin.copy:",
                    "        dest: /etc/systemd/system.conf.d/99-cve-java.conf",
                    "        mode: '0644'",
                    "        content: |",
                    "          [Manager]",
                    f'          DefaultEnvironment="JDK_JAVA_OPTIONS={flags}"',
                    "      notify: Reload systemd daemon",
                    ""
                ])
                state["emitted_systemd"] = True
                state["has_systemd_reload"] = True
            if not state.get("emitted_profile"):
                lines.extend([
                    f'    - name: "{cve_tag}[{attr}] Configure shell profile JVM mitigation ({flags})"',
                    "      ansible.builtin.copy:",
                    "        dest: /etc/profile.d/cve-java.sh",
                    "        mode: '0644'",
                    "        content: |",
                    f'          export JDK_JAVA_OPTIONS="{flags}"',
                    ""
                ])
                state["emitted_profile"] = True
            continue

        # 4. Tomcat JVM drop-in
        if "/etc/tomcat/conf.d" in cmd:
            if not state.get("emitted_tomcat"):
                m = re.search(r'JAVA_OPTS="\$\{JAVA_OPTS\} ([^"]+)"', cmd)
                flags = m.group(1) if m else "-XX:-UseBASE64Intrinsics"
                lines.extend([
                    f'    - name: "{cve_tag}[{attr}] Check if /etc/tomcat/conf.d exists"',
                    "      ansible.builtin.stat:",
                    "        path: /etc/tomcat/conf.d",
                    "      register: tomcat_conf_dir",
                    "",
                    f'    - name: "{cve_tag}[{attr}] Configure Tomcat JVM mitigation drop-in ({flags})"',
                    "      ansible.builtin.copy:",
                    "        dest: /etc/tomcat/conf.d/99-cve-mitigation.conf",
                    "        mode: '0644'",
                    "        content: |",
                    f'          JAVA_OPTS="${{JAVA_OPTS}} {flags}"',
                    "      when: tomcat_conf_dir.stat.exists",
                    "      notify: Restart Java and SUSE Manager services",
                    ""
                ])
                state["emitted_tomcat"] = True
                state["has_java_restart"] = True
            continue

        # 5. OpenSSH LoginGraceTime drop-in
        if "LoginGraceTime 0" in cmd and "/etc/ssh/sshd_config.d/" in cmd:
            lines.extend([
                f'    - name: "{cve_tag}[{attr}] Ensure /etc/ssh/sshd_config.d directory exists"',
                "      ansible.builtin.file:",
                "        path: /etc/ssh/sshd_config.d",
                "        state: directory",
                "        mode: '0755'",
                "",
                f'    - name: "{cve_tag}[{attr}] Set OpenSSH LoginGraceTime to 0"',
                "      ansible.builtin.copy:",
                "        dest: /etc/ssh/sshd_config.d/99-cve-mitigation.conf",
                "        mode: '0644'",
                "        validate: /usr/sbin/sshd -t -f %s",
                "        content: |",
                f"          # [Due to {attr}] {raw_title}",
                "          LoginGraceTime 0",
                "      notify: Reload sshd",
                ""
            ])
            state["has_sshd_reload"] = True
            continue

        # 6. Kernel module modprobe blacklist
        if "/etc/modprobe.d/" in cmd and "install " in cmd and "/bin/true" in cmd:
            m_dst = re.search(r"(/etc/modprobe\.d/[A-Za-z0-9_.\-]+\.conf)", cmd)
            dst_file = m_dst.group(1) if m_dst else "/etc/modprobe.d/cve-mitigation.conf"
            mods = re.findall(r"install\s+([A-Za-z0-9_\-]+)\s+/bin/true", cmd)
            if mods:
                mod_list = ", ".join(mods)
                lines.extend([
                    f'    - name: "{cve_tag}[{attr}] Blacklist kernel module(s) ({mod_list}) in {dst_file}"',
                    "      ansible.builtin.copy:",
                    f"        dest: {dst_file}",
                    "        mode: '0644'",
                    "        content: |",
                    f"          # [Due to {attr}] {raw_title}",
                ])
                for mod in mods:
                    lines.append(f"          install {mod} /bin/true")
                lines.append("")
                for mod in mods:
                    lines.extend([
                        f'    - name: "{cve_tag}[{attr}] Unload kernel module {mod} if currently loaded"',
                        "      ansible.builtin.command:",
                        f"        cmd: modprobe -r {mod}",
                        "      changed_when: false",
                        "      failed_when: false",
                        ""
                    ])
                continue

        # 7. sysctl kernel hardening (preserving custom /etc/sysctl.d/*.conf path if specified)
        if cmd.startswith("sysctl -w "):
            m_sc = re.search(r"(/etc/sysctl\.d/[A-Za-z0-9_.\-]+\.conf)", cmd)
            sysctl_file = m_sc.group(1) if m_sc else "/etc/sysctl.d/99-cve-mitigation.conf"
            kv_tokens = [tok for tok in cmd.split("sysctl -w ", 1)[1].split("&&")[0].strip().split() if "=" in tok]
            for kv in kv_tokens:
                k_name, k_val = [x.strip() for x in kv.split("=", 1)]
                if (k_name, k_val) in state["seen_sysctls"]:
                    continue
                state["seen_sysctls"].add((k_name, k_val))
                lines.extend([
                    f'    - name: "{cve_tag}[{attr}] Apply sysctl kernel mitigation ({k_name}={k_val})"',
                    "      ansible.posix.sysctl:",
                    f"        name: {k_name}",
                    f"        value: '{k_val}'",
                    f"        sysctl_file: {sysctl_file}",
                    "        reload: true",
                    "      when: ansible_facts['os_family'] == 'Suse'",
                    ""
                ])
            continue

        # 8. Active Java process inspection
        if "ps -ef | grep" in cmd:
            lines.extend([
                f'    - name: "{cve_tag}[{attr}] {title}"',
                "      ansible.builtin.shell: ps -ef | grep -E '[j]ava' || true",
                "      register: active_java_procs",
                "      changed_when: false",
                ""
            ])
            continue

        # 9. Generic multi-line-safe shell fallback
        lines.extend([
            f'    - name: "{cve_tag}[{attr}] {title}"',
            "      ansible.builtin.shell: |",
        ])
        for cln in cmd.splitlines():
            lines.append(f"        {cln}")
        lines.extend([
            "      when: ansible_facts['os_family'] == 'Suse'",
            ""
        ])

    return task_idx


def _append_ansible_handlers(lines: list, state: dict) -> None:
    if state.get("has_systemd_reload") or state.get("has_java_restart") or state.get("has_sshd_reload"):
        lines.append("  handlers:")
        if state.get("has_systemd_reload"):
            lines.extend([
                "    - name: Reload systemd daemon",
                "      ansible.builtin.systemd:",
                "        daemon_reload: true",
                ""
            ])
        if state.get("has_java_restart"):
            lines.extend([
                "    - name: Restart Java and SUSE Manager services",
                "      ansible.builtin.shell: |",
                "        spacewalk-service restart 2>/dev/null || systemctl try-restart tomcat taskomatic rhn-search",
                ""
            ])
        if state.get("has_sshd_reload"):
            lines.extend([
                "    - name: Reload sshd",
                "      ansible.builtin.systemd:",
                "        name: sshd",
                "        state: reloaded",
                ""
            ])


def render_ansible_config(cve: str, rel_arg: str, mitigation_data: dict, force_workaround: bool = False) -> str:
    safe_cve = re.sub(r'[^A-Za-z0-9_]', '_', cve.lower())
    cvss = mitigation_data.get("cvss", "N/A")
    vec = mitigation_data.get("attack_vector", "UNKNOWN")
    kev = "YES (CISA KEV)" if (mitigation_data.get("cisa_kev") or {}).get("known_exploited") else "No"
    bz_list = mitigation_data.get("bugzilla") or []
    lines = [
        "---",
        f"# Auto-generated Ansible Playbook for {cve} (Target: {rel_arg})",
        f"# CVSS    : {cvss} | Vector: {vec} | CISA KEV: {kev}",
        f"# Advisory: https://www.suse.com/security/cve/{cve}.html | https://nvd.nist.gov/vuln/detail/{cve}",
    ]
    if bz_list:
        lines.append(f"# Bugzilla: {', '.join(bz_list[:4])}")
    lines.extend([
        f"# Dry-run : ansible-playbook -i inventory.ini {safe_cve}.yml --check --diff",
        f"# Apply   : ansible-playbook -i inventory.ini {safe_cve}.yml",
        "#",
        "# DISCLAIMER: Provided as-is without warranty. Service names, config paths (Tomcat/systemd/wrapper),",
        "# and runtime flags may vary across SLES versions, SUMA/Uyuni, or custom setups. Test before production rollout.",
        "",
        f"- name: Remediate or mitigate {cve} on SUSE Enterprise Linux ({rel_arg})",
        "  hosts: all",
        "  become: true",
        "  gather_facts: true",
        "  tasks:"
    ])

    rems = mitigation_data.get("remediation") or []
    sugs = mitigation_data.get("suggestions") or []

    if rems and not force_workaround:
        rem = rems[0]
        cmd = rem["cmd"].split("  #")[0].strip()
        is_micro = "transactional-update" in cmd
        lines.append(f"    # [Due to Official SUSE Vendor Patch] {rem.get('title', 'Apply vendor security update')}")
        lines.append(f"    # Source / Verify: https://www.suse.com/security/cve/{cve}.html")
        if is_micro:
            lines.extend([
                f"    - name: Apply SL Micro transactional patch for {cve}",
                "      ansible.builtin.command:",
                "        cmd: transactional-update patch",
                "      register: tu_patch_result",
                "      changed_when: tu_patch_result.rc == 0",
                "      when: ansible_facts['os_family'] == 'Suse'",
                "",
                "    - name: Reboot SL Micro host to activate transactional snapshot",
                "      ansible.builtin.reboot:",
                f'        msg: "Reboot triggered by {cve} transactional security update"',
                "      when: tu_patch_result is changed",
                ""
            ])
        else:
            needs_reboot = "REBOOT REQUIRED" in rem.get("title", "")
            lines.extend([
                f"    - name: Refresh zypper repositories and apply security patch for {cve}",
                "      ansible.builtin.shell: |",
                f"        zypper --non-interactive refresh && zypper --non-interactive patch --cve={cve}",
                "      register: zypper_patch_out",
                "      changed_when: \"'Nothing to do.' not in zypper_patch_out.stdout\"",
                "      when: ansible_facts['os_family'] == 'Suse'",
                "",
                "    - name: Check for services using deleted libraries (zypper ps -s)",
                "      ansible.builtin.command:",
                "        cmd: zypper ps -s",
                "      register: zypper_ps_out",
                "      changed_when: false",
                ""
            ])
            if needs_reboot:
                lines.extend([
                    f"    - name: Reboot host to activate kernel/core library updates for {cve}",
                    "      ansible.builtin.reboot:",
                    f'        msg: "Reboot required after applying {cve} security patch"',
                    "      when: zypper_patch_out is changed",
                    ""
                ])
        lines = [("    " + ln.lstrip() if ln.lstrip().startswith("- name:") and not ln.lstrip().startswith("- name: Remediate") else ln) for ln in ("\n".join(lines)).splitlines()]
        return "\n".join(lines)

    state = {"seen_sysctls": set()}
    task_idx = _emit_ansible_suggestion_tasks(cve, sugs, lines, state, prefix_cve=False)

    if task_idx == 0:
        noop_msg = sugs[0].get("title", f"No actionable SLES workaround required for {cve}").replace('"', "'") if sugs else f"No actionable SLES workaround required for {cve}"
        lines.extend([
            f'    - name: "{noop_msg}"',
            "      ansible.builtin.debug:",
            f'        msg: "{noop_msg}"',
            "      changed_when: false",
            ""
        ])

    _append_ansible_handlers(lines, state)
    lines = [("    " + ln.lstrip() if ln.lstrip().startswith("- name:") and not ln.lstrip().startswith("- name: Remediate") else ln) for ln in ("\n".join(lines)).splitlines()]
    return "\n".join(lines)


def render_batch_salt_config(rel_arg: str, batch_items: list, force_workaround: bool = False) -> str:
    cve_ids = [it.get("cve", "") for it in batch_items if it.get("cve")]
    lines = [
        f"# Auto-generated Multi-CVE SaltStack State ({len(cve_ids)} CVEs | Target: {rel_arg})",
        f"# CVEs    : {', '.join(cve_ids)}",
        "# Save to : /srv/salt/cve_batch_remediation.sls  (Note: omit .sls & match exact case in state.apply)",
        "# Dry-run : salt -G 'os_family:Suse' state.apply cve_batch_remediation test=True",
        "# Apply   : salt -G 'os_family:Suse' state.apply cve_batch_remediation",
        "#",
        "# DISCLAIMER: Provided as-is without warranty. Service names, config paths (Tomcat/systemd/wrapper),",
        "# and runtime flags may vary across SLES versions, SUMA/Uyuni, or custom setups. Test before production rollout.",
        ""
    ]

    if not batch_items:
        lines.extend([
            "cve_batch_no_matching_targets:",
            "  test.succeed_without_changes:",
            f'    - name: "No matching open CVEs to remediate or mitigate on {rel_arg}"',
            ""
        ])
        return "\n".join(lines)

    patchable_cves = []
    is_micro_batch = False
    any_reboot_required = False
    workaround_items = []
    noop_items = []

    for it in batch_items:
        cve = it.get("cve", "")
        meta = it.get("meta", {})
        triage_upper = meta.get("triage_status", "").upper()
        mit = it.get("mitigation") or {}
        rems = mit.get("remediation") or []

        if "NOT AFFECTED" in triage_upper:
            noop_items.append((cve, f"{cve} is NOT AFFECTED on {rel_arg} — no action required"))
            continue

        if rems and not force_workaround:
            rem = rems[0]
            cmd = rem.get("cmd", "")
            if "transactional-update" in cmd:
                is_micro_batch = True
            if "REBOOT REQUIRED" in rem.get("title", ""):
                any_reboot_required = True
            patchable_cves.append(cve)
        else:
            workaround_items.append((cve, mit))

    if patchable_cves:
        if is_micro_batch:
            lines.extend([
                "cve_batch_transactional_patch:",
                "  cmd.run:",
                "    - name: transactional-update patch",
                "    - onlyif: which transactional-update >/dev/null 2>&1",
                ""
            ])
            patch_state_ref = "cve_batch_transactional_patch"
        else:
            cve_flags = " ".join(f"--cve={c}" for c in patchable_cves)
            grep_expr = "|".join(re.escape(c) for c in patchable_cves)
            lines.extend([
                "cve_batch_zypper_patch:",
                "  cmd.run:",
                f"    - name: zypper --non-interactive refresh && zypper --non-interactive patch {cve_flags}",
                f"    - onlyif: zypper --non-interactive list-patches | grep -E '({grep_expr})' | grep -q 'Needed'",
                ""
            ])
            patch_state_ref = "cve_batch_zypper_patch"

        if any_reboot_required or is_micro_batch:
            lines.extend([
                "cve_batch_reboot_notice:",
                "  test.show_notification:",
                f"    - text: \"Batch security patches applied ({', '.join(patchable_cves)}) — schedule system reboot to activate updated kernel/core libraries.\"",
                "    - require:",
                f"      - cmd: {patch_state_ref}",
                ""
            ])

    state = {"seen_sysctls": set()}

    for cve, mit in workaround_items:
        sugs = mit.get("suggestions") or []
        lines.append(f"# --- Compensating Workarounds: {cve} ---")
        step_idx = _emit_salt_suggestion_states(cve, sugs, lines, state, prefix_batch=True)

        if step_idx == 0:
            noop_msg = sugs[0].get("title", f"No automated SLES workaround available for {cve}").replace('"', "'") if sugs else f"No automated SLES workaround available for {cve}"
            noop_items.append((cve, noop_msg))

    _append_salt_handlers(lines, state, "cve_batch")

    for cve, msg in noop_items:
        safe_cve = re.sub(r'[^A-Za-z0-9_]', '_', cve.lower())
        clean_msg = msg.replace('"', "'")
        lines.extend([
            f"{safe_cve}_audit_noop:",
            "  test.succeed_without_changes:",
            f'    - name: "{clean_msg}"',
            ""
        ])

    return "\n".join(lines)


def render_batch_ansible_config(rel_arg: str, batch_items: list, force_workaround: bool = False) -> str:
    cve_ids = [it.get("cve", "") for it in batch_items if it.get("cve")]
    lines = [
        "---",
        f"# Auto-generated Multi-CVE Ansible Playbook ({len(cve_ids)} CVEs | Target: {rel_arg})",
        f"# CVEs    : {', '.join(cve_ids)}",
        "# Dry-run : ansible-playbook -i inventory.ini cve_batch_remediation.yml --check --diff",
        "# Apply   : ansible-playbook -i inventory.ini cve_batch_remediation.yml",
        "#",
        "# DISCLAIMER: Provided as-is without warranty. Service names, config paths (Tomcat/systemd/wrapper),",
        "# and runtime flags may vary across SLES versions, SUMA/Uyuni, or custom setups. Test before production rollout.",
        "",
        f"- name: Batch remediate or mitigate {len(cve_ids)} CVEs on SUSE Enterprise Linux ({rel_arg})",
        "  hosts: all",
        "  become: true",
        "  gather_facts: true",
        "  tasks:"
    ]

    if not batch_items:
        lines.extend([
            f"    - name: No matching open CVEs to remediate or mitigate on {rel_arg}",
            "      ansible.builtin.debug:",
            f'        msg: "No matching open CVEs on {rel_arg}"',
            "      changed_when: false",
            ""
        ])
        return "\n".join(lines)

    patchable_cves = []
    is_micro_batch = False
    any_reboot_required = False
    workaround_items = []
    noop_items = []

    for it in batch_items:
        cve = it.get("cve", "")
        meta = it.get("meta", {})
        triage_upper = meta.get("triage_status", "").upper()
        mit = it.get("mitigation") or {}
        rems = mit.get("remediation") or []

        if "NOT AFFECTED" in triage_upper:
            noop_items.append((cve, f"{cve} is NOT AFFECTED on {rel_arg} — no action required"))
            continue

        if rems and not force_workaround:
            rem = rems[0]
            cmd = rem.get("cmd", "")
            if "transactional-update" in cmd:
                is_micro_batch = True
            if "REBOOT REQUIRED" in rem.get("title", ""):
                any_reboot_required = True
            patchable_cves.append(cve)
        else:
            workaround_items.append((cve, mit))

    if patchable_cves:
        joined_cves = ", ".join(patchable_cves)
        if is_micro_batch:
            lines.extend([
                f"    - name: Apply SL Micro transactional security patches ({joined_cves})",
                "      ansible.builtin.command:",
                "        cmd: transactional-update patch",
                "      register: tu_batch_patch_result",
                "      changed_when: tu_batch_patch_result.rc == 0",
                "      when: ansible_facts['os_family'] == 'Suse'",
                "",
                "    - name: Reboot SL Micro host to activate transactional snapshot",
                "      ansible.builtin.reboot:",
                f"        msg: \"Reboot triggered by batch transactional security update ({joined_cves})\"",
                "      when: tu_batch_patch_result is changed",
                ""
            ])
        else:
            cve_flags = " ".join(f"--cve={c}" for c in patchable_cves)
            lines.extend([
                f"    - name: Refresh zypper repositories and apply security patches ({joined_cves})",
                "      ansible.builtin.shell: |",
                f"        zypper --non-interactive refresh && zypper --non-interactive patch {cve_flags}",
                "      register: zypper_batch_patch_out",
                "      changed_when: \"'Nothing to do.' not in zypper_batch_patch_out.stdout\"",
                "      when: ansible_facts['os_family'] == 'Suse'",
                "",
                "    - name: Check for services using deleted libraries (zypper ps -s)",
                "      ansible.builtin.command:",
                "        cmd: zypper ps -s",
                "      register: zypper_batch_ps_out",
                "      changed_when: false",
                ""
            ])
            if any_reboot_required:
                lines.extend([
                    f"    - name: Reboot host to activate kernel/core library updates ({joined_cves})",
                    "      ansible.builtin.reboot:",
                    f"        msg: \"Reboot required after applying batch security patches ({joined_cves})\"",
                    "      when: zypper_batch_patch_out is changed",
                    ""
                ])

    state = {"seen_sysctls": set()}

    for cve, mit in workaround_items:
        sugs = mit.get("suggestions") or []
        lines.append(f"    # --- Compensating Workarounds: {cve} ---")
        task_idx = _emit_ansible_suggestion_tasks(cve, sugs, lines, state, prefix_cve=True)

        if task_idx == 0:
            noop_msg = sugs[0].get("title", f"No automated SLES workaround available for {cve}").replace('"', "'") if sugs else f"No automated SLES workaround available for {cve}"
            noop_items.append((cve, noop_msg))

    for cve, msg in noop_items:
        clean_msg = msg.replace('"', "'")
        lines.extend([
            f'    - name: "[{cve}] {clean_msg}"',
            "      ansible.builtin.debug:",
            f'        msg: "{clean_msg}"',
            "      changed_when: false",
            ""
        ])

    _append_ansible_handlers(lines, state)
    lines = [("    " + ln.lstrip() if ln.lstrip().startswith("- name:") and not ln.lstrip().startswith("- name: Batch remediate") else ln) for ln in ("\n".join(lines)).splitlines()]
    return "\n".join(lines)


def print_mitigation_block(mit: dict, view_mode: str = 'all'):
    print(f"{CLR_MAG}[MITIGATION & MULTI-SOURCE ADVISORY INTEL]{CLR_RESET}")

    kev = mit.get("cisa_kev") or {}
    if kev.get("exploited"):
        print(f"  \033[1;31m[!] CISA KEV ALERT: ACTIVELY EXPLOITED (added {kev.get('date_added')} | Ransomware: {kev.get('ransomware')})\033[0m")

    cwe_str = f" | {', '.join(mit['cwes'])}" if mit["cwes"] else ""
    si = mit.get("suse_intel") or {}
    if si:
        sparts = []
        if si.get("rating"): sparts.append(f"Rating: {si['rating']}")
        if si.get("state"): sparts.append(f"State: {si['state']}")
        if si.get("cvss3"): sparts.append(f"CVSS v3: {si['cvss3']}")
        if si.get("cvss4"): sparts.append(f"CVSS v4: {si['cvss4']}")
        if sparts:
            print(f"  {CLR_BOLD}SUSE Advisory:{CLR_RESET} {' | '.join(sparts)}")
    if not (str(mit["cvss"]).startswith("N/A") and (si.get("cvss3") or si.get("cvss4"))):
        print(f"  {CLR_BOLD}NVD CVSS:{CLR_RESET} {mit['cvss']} | {CLR_BOLD}Vector:{CLR_RESET} {mit['attack_vector']}{cwe_str}")

    import textwrap
    desc = re.sub(r'\s+', ' ', mit["description"]).strip()
    print(textwrap.fill(f"Summary: {desc}", width=116, initial_indent="  ", subsequent_indent="  ").replace("Summary:", f"{CLR_BOLD}Summary:{CLR_RESET}", 1))

    has_rh_in_suggestions = any("Red Hat" in (s.get("source_attribution") or "") for s in (mit.get("suggestions") or []))
    if mit.get("redhat_mitigation") and "see the security bulletin" not in mit["redhat_mitigation"].lower() and not (has_rh_in_suggestions and view_mode != "remediate"):
        print(f"\n  {CLR_BOLD}Red Hat Security Mitigation (CC BY 4.0):{CLR_RESET}")
        print(textwrap.fill(mit["redhat_mitigation"], width=116, initial_indent="  ", subsequent_indent="  "))

    if mit.get("redhat_statement"):
        stmt = re.sub(r'\s+', ' ', mit["redhat_statement"]).strip()
        print(f"\n  {CLR_BOLD}Red Hat Statement:{CLR_RESET}")
        print(textwrap.fill(stmt, width=116, initial_indent="  ", subsequent_indent="  "))

    if mit.get("ubuntu_notes"):
        print(f"\n  {CLR_BOLD}Ubuntu Security Maintainer Notes:{CLR_RESET}")
        for note in mit["ubuntu_notes"]:
            print(f"  - {note[:260] + ('...' if len(note) > 260 else '')}")

    if mit.get("bugzilla"):
        print(f"\n  {CLR_BOLD}SUSE Bugzilla:{CLR_RESET} {', '.join(mit['bugzilla'])}")

    if mit.get("vendor_refs"):
        print(f"  {CLR_BOLD}Vendor Advisories & KBs:{CLR_RESET} {', '.join(mit['vendor_refs'])}")

    if mit.get("remediation") and view_mode != "mitigate":
        print(f"\n  {CLR_BOLD}Recommended SLES Remediation (Patch Available):{CLR_RESET}")
        for idx, rem in enumerate(mit["remediation"], 1):
            print(f"  {idx}. {CLR_BOLD}{rem['title']}{CLR_RESET}")
            print(f"     {CLR_CYAN}$ {rem['cmd']}{CLR_RESET}")
    elif view_mode == "remediate" and not mit.get("remediation"):
        print(f"\n  {CLR_BOLD}No official SUSE vendor patch released yet.{CLR_RESET} Run with {CLR_BOLD}--mitigate{CLR_RESET} to view compensating workarounds.")

    if mit.get("suggestions") and view_mode != "remediate":
        if mit.get("remediation"):
            w_hdr = "Compensating Workarounds (Only if patch installation must be deferred):"
        elif mit.get("partial_patch"):
            w_hdr = "Recommended SLES Workarounds (For unpatched releases/packages — see [PATCHES] for patched releases):"
        else:
            w_hdr = "Recommended SLES Workarounds (No patch released yet):"
        print(f"\n  {CLR_BOLD}{w_hdr}{CLR_RESET}")
        default_verify_urls = [
            f"https://www.suse.com/security/cve/{(mit.get('cve_id') or mit.get('cve') or '')}.html",
            f"https://nvd.nist.gov/vuln/detail/{(mit.get('cve_id') or mit.get('cve') or '')}",
        ]
        for idx, s in enumerate(mit["suggestions"], 1):
            attr = s.get("source_attribution")
            urls = s.get("source_urls") or []
            if "No SLES packages affected" in s.get("title", ""):
                print(f"  {idx}. {CLR_BOLD}{s['title']}{CLR_RESET}")
            else:
                attr_label = attr or "SUSE / NVD Security Hardening Guidance"
                verify_urls = urls if urls else default_verify_urls
                print(f"  {idx}. {CLR_MAG}[Due to {attr_label}]{CLR_RESET} {CLR_BOLD}{s['title']}{CLR_RESET}")
                print(f"     {CLR_DIM}Source / Verify: {' | '.join(verify_urls)}{CLR_RESET}")
            for cln in str(s['cmd']).splitlines():
                print(f"     {CLR_CYAN}$ {cln}{CLR_RESET}" if cln == str(s['cmd']).splitlines()[0] else f"       {CLR_CYAN}{cln}{CLR_RESET}")
            if s.get("rollback"):
                print(f"     {CLR_DIM}Rollback (post-patch): {s['rollback']}{CLR_RESET}")
        import textwrap
        disc_txt = mit.get("workaround_disclaimer") or 'Note: Workarounds are provided as-is without warranty and may not apply 1:1 to every environment. Service names, config paths (e.g., Tomcat, systemd, or wrapper layouts), and runtime flags can vary across SLES releases, SUSE Manager/Uyuni, or custom deployments—verify and adapt to your local setup before applying in production.'
        print(f"\n{CLR_DIM}{textwrap.fill(disc_txt, width=116, initial_indent='  ', subsequent_indent='  ')}{CLR_RESET}")

    print(f"\n  {CLR_DIM}Sources: {', '.join(mit.get('sources', []))}{CLR_RESET}\n")


def build_index():
    print("=== Building local OVAL index (SLES 12, 15, 16) ===")
    tmp_db = DB_PATH + ".tmp"
    if os.path.exists(tmp_db):
        os.remove(tmp_db)

    conn = sqlite3.connect(tmp_db)
    with conn:
        conn.execute("CREATE TABLE IF NOT EXISTS cve_catalog (cve TEXT, major TEXT, platform TEXT, package TEXT, status TEXT)")
        conn.execute("CREATE INDEX IF NOT EXISTS idx_cve_search ON cve_catalog(cve, major)")

    files = [
        ("suse.linux.enterprise.16.xml.bz2", "16", "RELEASED"),
        ("suse.linux.enterprise.16-affected.xml.bz2", "16", "AFFECTED"),
        ("suse.linux.enterprise.15.xml.bz2", "15", "RELEASED"),
        ("suse.linux.enterprise.15-affected.xml.bz2", "15", "AFFECTED"),
        ("suse.linux.enterprise.12.xml.bz2", "12", "RELEASED"),
        ("suse.linux.enterprise.12-affected.xml.bz2", "12", "AFFECTED"),
    ]

    total_count = 0
    for fname, major, base_status in files:
        fpath = os.path.join(DATA_DIR, fname)
        if not os.path.exists(fpath):
            continue
        print(f"Indexing {fname} ...", flush=True)
        batch = []
        with bz2.open(fpath, "rb") as bz:
            context = ET.iterparse(bz, events=("end",))
            for event, elem in context:
                if not elem.tag.endswith("definition"):
                    continue

                found_cves = set()
                for ref in elem.findall(".//{*}reference"):
                    rid = ref.attrib.get("ref_id", "")
                    m = re.search(r'CVE-\d{4}-\d+', rid, re.IGNORECASE)
                    if m:
                        found_cves.add(m.group(0).upper())
                for c_node in elem.findall(".//{*}cve"):
                    txt = c_node.text or ""
                    m = re.search(r'CVE-\d{4}-\d+', txt, re.IGNORECASE)
                    if m:
                        found_cves.add(m.group(0).upper())

                if found_cves:
                    platforms = [p.text.strip() for p in elem.findall(".//{*}platform") if p.text]
                    if not platforms:
                        platforms = [f"SUSE Linux Enterprise {major}"]

                    pkg_names = set()
                    for crit in elem.findall(".//{*}criterion"):
                        comment = crit.attrib.get("comment", "")
                        m_pkg = re.match(r'^([^ ]+)', comment)
                        if m_pkg and not m_pkg.group(1).startswith("SUSE"):
                            cleaned = clean_pkg_name(m_pkg.group(1))
                            if cleaned:
                                pkg_names.add(cleaned)

                    pkg_str = ", ".join(sorted(pkg_names)) if pkg_names else "all"
                    for c in found_cves:
                        for p in platforms:
                            batch.append((c, major, p, pkg_str, base_status))

                elem.clear()
                while elem.getprevious() is not None:
                    del elem.getparent()[0]

                if len(batch) >= 20000:
                    with conn:
                        conn.executemany("INSERT INTO cve_catalog VALUES (?, ?, ?, ?, ?)", batch)
                    total_count += len(batch)
                    batch.clear()

        if batch:
            with conn:
                conn.executemany("INSERT INTO cve_catalog VALUES (?, ?, ?, ?, ?)", batch)
            total_count += len(batch)

    conn.close()
    os.replace(tmp_db, DB_PATH)
    print(f"Index built successfully! {total_count} entries indexed.\n")



def extract_batch_cves(cve_tokens, file_path=None):
    """Parse, normalize, validate, and deduplicate CVE identifiers from CLI tokens and/or file/stdin."""
    raw_items = []
    if file_path is not None:
        if file_path == "-":
            lines = sys.stdin.read().splitlines()
        else:
            if not os.path.exists(file_path):
                print(f"Error: CVE input file not found: {file_path}", file=sys.stderr)
                sys.exit(1)
            with open(file_path, "r", encoding="utf-8", errors="replace") as fh:
                lines = fh.read().splitlines()
        for line in lines:
            line = line.split("#", 1)[0].strip()
            if not line:
                continue
            for part in re.split(r"[\s,;]+", line):
                if part.strip():
                    raw_items.append(part.strip())

    for tok in cve_tokens:
        for part in re.split(r"[\s,;]+", tok):
            if part.strip():
                raw_items.append(part.strip())

    cves = []
    seen = set()
    invalid = []
    for item in raw_items:
        norm = item.strip().rstrip(".,;:").upper()
        if not norm.startswith("CVE-"):
            norm = f"CVE-{norm}"
        if not re.match(r"^CVE-\d{4}-\d{4,}$", norm):
            invalid.append(item)
            continue
        if norm not in seen:
            seen.add(norm)
            cves.append(norm)

    if invalid:
        print(f"Error: Invalid CVE identifier(s) in batch input: {', '.join(invalid)}", file=sys.stderr)
        sys.exit(1)
    if not cves:
        print("Error: No valid CVE identifiers provided for batch scan.", file=sys.stderr)
        sys.exit(1)
    return cves


def rank_suse_patch_id(pid: str):
    if "Live-Patching" in pid:
        tier = 4
    elif "Development-Tools" in pid or "SLES_SAP" in pid:
        tier = 3
    elif "Module-Basesystem" in pid or "Module-Server-Applications" in pid:
        tier = 2
    elif "Product-SLES" in pid or "SLE-SERVER" in pid or pid.startswith("SUSE-20"):
        tier = 1
    else:
        tier = 2
    return (tier, pid)


def format_triage_row(item, rel_arg=None):
    """Build normalized summary table row dict from a single-CVE JSON payload."""
    meta = item.get("meta", {})
    mit = item.get("mitigation", {}) or {}
    suse_intel = mit.get("suse_intel", {}) or {}
    kev_raw = mit.get("cisa_kev")
    kev_intel = kev_raw if isinstance(kev_raw, dict) else {"in_kev": bool(kev_raw and "YES" in str(kev_raw).upper())}

    triage_full = meta.get("triage_status", "UNKNOWN")
    triage_short = triage_full.split("(", 1)[0].strip() if "(" in triage_full else triage_full
    triage_upper = triage_short.upper()

    is_kev = bool(kev_intel.get("in_kev") or kev_intel.get("listed") or kev_intel.get("known_exploited"))

    cvss_raw = mit.get("cvss")
    cvss_dict = cvss_raw if isinstance(cvss_raw, dict) else {}
    rating = suse_intel.get("rating") or cvss_dict.get("severity") or ""
    cvss = suse_intel.get("cvss3") or cvss_dict.get("score") or (cvss_raw if isinstance(cvss_raw, str) else "")
    cvss_short = "" if (not cvss or str(cvss).strip().upper() == "N/A") else str(cvss).split()[0]
    if not rating and cvss_short:
        try:
            sc = float(cvss_short)
            rating = "CRITICAL" if sc >= 9.0 else ("HIGH" if sc >= 7.0 else ("MEDIUM" if sc >= 4.0 else "LOW"))
        except ValueError:
            rating = "N/A"
    rating = rating or "N/A"
    sev_str = f"{rating} ({cvss_short})" if cvss_short else str(rating)
    if is_kev:
        sev_str += " [KEV!]"

    lc = meta.get("target_lifecycle", {})
    if isinstance(lc, dict):
        lc_str = lc.get("state") or lc.get("label") or "ALL"
    else:
        lc_str = str(lc) if lc else "ALL"

    raw_patches = item.get("patches") or {}
    patch_entries = []
    if isinstance(raw_patches, dict):
        for plist in raw_patches.values():
            if isinstance(plist, list):
                patch_entries.extend(plist)
            elif plist:
                patch_entries.append(plist)
    elif isinstance(raw_patches, list):
        patch_entries.extend(raw_patches)
    patch_ids = sorted(
        {re.sub(r'\s*\([^)]*\)$', '', str(x.get("patch_id") or x.get("id") or x.get("patch") or "" if isinstance(x, dict) else x)).strip() for x in patch_entries if x},
        key=rank_suse_patch_id
    )
    if patch_ids:
        action_str = ", ".join(patch_ids[:2]) + (f" (+{len(patch_ids)-2})" if len(patch_ids) > 2 else "")
    elif "NOT AFFECTED" in triage_upper:
        action_str = "None (Not Affected)"
    elif triage_upper.startswith("PATCHED") or triage_upper.startswith("RELEASED"):
        action_str = "Patched (Vendor Release)"
    else:
        suse_state = suse_intel.get("state") or "Pending"
        target_tok = rel_arg or meta.get("target") or meta.get("release") or "all"
        cve_tok = item.get("cve", "")
        if suse_state.strip().lower() == "resolved":
            state_note = "No Target RPM Yet | SUSE: Resolved Upstream"
        else:
            state_note = f"No Patch | SUSE: {suse_state}"
        action_str = f"suse-cve {target_tok} {cve_tok} --mitigate ({state_note})"

    return {
        "cve": item.get("cve", ""),
        "status": triage_short,
        "status_detail": triage_full,
        "severity": sev_str,
        "lifecycle": lc_str,
        "action": action_str,
        "is_kev": is_kev,
        "triage_upper": triage_upper,
    }


def _extract_item_audit_meta(item: dict, severity_str: str = "") -> dict:
    mit = item.get("mitigation") or {}
    kev = mit.get("cisa_kev") or {}
    is_kev = bool(kev.get("exploited"))
    scores = []
    for k in ("suse_cvss", "nvd_cvss"):
        val = mit.get(k)
        if isinstance(val, dict):
            sc = val.get("score") or val.get("baseScore")
            if sc is not None:
                try: scores.append(float(sc))
                except Exception: pass
        elif isinstance(val, (int, float)):
            scores.append(float(val))
    if not scores and severity_str:
        m = re.search(r"\((\d+\.\d+)\)", severity_str)
        if m:
            scores.append(float(m.group(1)))
    return {"cisa_kev": "YES" if is_kev else "NO", "cvss": f"{max(scores):.1f}" if scores else "N/A"}

def render_batch_csv_report(rel_arg: str, rows: list, filtered_results: list) -> str:
    buf = io.StringIO()
    w = csv.writer(buf, lineterminator="\n")
    w.writerow(["CVE", "Target_Release", "Status", "Status_Detail", "Severity", "CVSS_Max", "CISA_KEV", "Lifecycle", "Recommended_Action", "CLI_Next_Step"])
    by_cve = {it.get("cve", ""): it for it in filtered_results}
    for r in rows:
        cid = r["cve"]
        meta = _extract_item_audit_meta(by_cve.get(cid, {}), r.get("severity", ""))
        st_u = r["status"].upper()
        if "NOT AFFECTED" in st_u or st_u.startswith(("PATCHED", "RELEASED")):
            cmd = "None (Compliant / Patched)"
        else:
            flg = "--remediate" if ("PARTIALLY" in st_u and not r["action"].startswith(("suse-cve ", "No Patch", "Patch "))) else "--mitigate"
            cmd = f"suse-cve {rel_arg} {cid} {flg}"
        w.writerow([cid, rel_arg, r["status"], r.get("status_detail", ""), r["severity"], meta["cvss"], meta["cisa_kev"], r["lifecycle"], r["action"], cmd])
    return buf.getvalue().rstrip("\n")

def render_batch_markdown_report(rel_arg: str, summary: dict, rows: list, filtered_results: list, errors: list, status_filter: str = None, only_open: bool = False, only_kev: bool = False) -> str:
    from datetime import datetime, timezone
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    flts = [status_filter or "ALL"] + (["--only-open"] if only_open else []) + (["--only-kev"] if only_kev else [])
    lines = [
        f"# SUSE Security Vulnerability Triage Report (`{rel_arg}`)", "",
        f"- **Generated:** {ts}",
        f"- **Target Release:** `{rel_arg}`",
        f"- **Active Filters:** `{chr(44).join(flts)}`", "",
        "## Executive Summary", "",
        "| Metric | Count |", "| :--- | ---: |",
        f"| **Total CVEs Evaluated** | {summary['total']} |",
        f"| **Open / Pending Remediation** | {summary['affected_or_pending']} |",
        f"| **Patched (Vendor Fix Released)** | {summary['patched']} |",
        f"| **Not Affected** | {summary['not_affected']} |",
        f"| **CISA KEV (Actively Exploited)** | {summary['cisa_kev']} |",
        f"| **Displayed Rows** | {summary['displayed']} |", "",
        "## Vulnerability Triage Matrix", "",
        "| CVE | Status | Severity | CVSS | CISA KEV | Lifecycle | Patches / Action |",
        "| :--- | :--- | :--- | :---: | :---: | :--- | :--- |",
    ]
    by_cve = {it.get("cve", ""): it for it in filtered_results}
    if not rows:
        lines.append("| _No CVEs matched the active filter_ | - | - | - | - | - | - |")
    for r in rows:
        meta = _extract_item_audit_meta(by_cve.get(r["cve"], {}), r.get("severity", ""))
        kev_b = "**YES**" if meta["cisa_kev"] == "YES" else "No"
        vals = [r[k].replace("|", "\\|") for k in ("status", "severity", "lifecycle", "action")]
        lines.append(f"| `{r['cve']}` | {vals[0]} | {vals[1]} | {meta['cvss']} | {kev_b} | {vals[2]} | {vals[3]} |")
    open_r = [r for r in rows if not ("NOT AFFECTED" in r["status"].upper() or r["status"].upper().startswith(("PATCHED", "RELEASED")))]
    if open_r:
        lines.extend(["", f"## Action Required — Open / Unpatched CVEs ({len(open_r)})", ""])
        for ur in open_r:
            st_u = ur["status"].upper()
            flg = "--remediate" if ("PARTIALLY" in st_u and not ur["action"].startswith(("suse-cve ", "No Patch", "Patch "))) else "--mitigate"
            lines.append(f"- **`{ur['cve']}`** ({ur['status']} | {ur['severity']}): `suse-cve {rel_arg} {ur['cve']} {flg}`")

        mit_sections = []
        for ur in open_r:
            it_obj = by_cve.get(ur["cve"], {})
            mit_obj = it_obj.get("mitigation") or {}
            sugs = mit_obj.get("suggestions") or []
            if not sugs:
                continue
            mit_sections.append(f"### `{ur['cve']}` — Compensating Mitigations ({ur['severity']})")
            mit_sections.append("")
            for idx_s, sg in enumerate(sugs, 1):
                attr = sg.get("source_attribution") or "SUSE / NVD Security Hardening Guidance"
                urls = sg.get("source_urls") or [f"https://www.suse.com/security/cve/{ur['cve']}.html"]
                mit_sections.append(f"{idx_s}. **[Due to {attr}]** {sg.get('title', '')}")
                mit_sections.append(f"   - **Source / Verify:** {' | '.join(urls)}")
                cmd_txt = str(sg.get("cmd", "")).strip()
                if cmd_txt and not cmd_txt.startswith("#"):
                    mit_sections.extend(["   ```bash", cmd_txt, "   ```"])
                if sg.get("rollback"):
                    mit_sections.append(f"   - **Rollback (post-patch):** `{sg['rollback']}`")
            mit_sections.append("")
        if mit_sections:
            lines.extend(["", "## Compensating Mitigations & Hardening Details", ""])
            lines.extend(mit_sections)
    if errors:
        lines.extend(["", "## Scan Errors", ""])
        for e in errors:
            lines.append(f"- **`{e['cve']}`**: {e['error']}")
    lines.extend([
        "", "## Audit & Compliance Status Guide", "",
        "- **PATCHED**: Vendor fix is published; apply via `zypper patch` or `transactional-update`.",
        "- **PARTIALLY PATCHED**: Core fix available, but sub-packages remain open; verify installed RPMs and apply workarounds.",
        "- **UNPATCHED / AFFECTED**: No official vendor RPM released yet; deploy compensating hardening (`--mitigate`) immediately.",
        "- **NOT AFFECTED**: Target release is not vulnerable; retain this report as audit evidence.",
    ])
    return "\n".join(lines)

def run_batch_query(rel_arg, cve_list, status_filter=None, as_json=False, as_csv=False, as_markdown=False, with_mitigation=True, config_mode=None, force_workaround=False, view_mode="all", only_open=False, only_kev=False):
    """Parallel batch orchestrator executing up to 8 concurrent CVE queries while preserving deterministic input order."""
    import io

    orig_out, orig_err = sys.stdout, sys.stderr
    tl_out = _ThreadLocalStream(orig_out)
    tl_err = _ThreadLocalStream(orig_err)
    sys.stdout = tl_out
    sys.stderr = tl_err

    def _eval_one(cve):
        buf = io.StringIO()
        err_buf = io.StringIO()
        tl_out.set_target(buf)
        tl_err.set_target(err_buf)
        try:
            query(
                rel_arg,
                cve,
                status_filter,
                as_json=True,
                with_mitigation=(True if config_mode else with_mitigation),
                config_mode=None,
                force_workaround=force_workaround,
                view_mode=view_mode,
                allow_prompt=False,
            )
        except SystemExit as exc:
            if exc.code not in (0, None):
                err_msg = err_buf.getvalue().strip() or f"Exited with code {exc.code}"
                return ("err", {"cve": cve, "error": err_msg})
        finally:
            tl_out.clear_target()
            tl_err.clear_target()
        raw_out = buf.getvalue().strip()
        if raw_out:
            return ("ok", json.loads(raw_out))
        return ("err", {"cve": cve, "error": "Empty response"})

    results = []
    errors = []
    workers = min(6, max(1, len(cve_list)))
    try:
        with ThreadPoolExecutor(max_workers=workers) as pool:
            outcomes = list(pool.map(_eval_one, cve_list))
    finally:
        sys.stdout = orig_out
        sys.stderr = orig_err

    for kind, payload in outcomes:
        if kind == "ok":
            results.append(payload)
        else:
            errors.append(payload)



    summary = {
        "total": len(cve_list),
        "scanned": len(results),
        "errors": len(errors),
        "not_affected": 0,
        "patched": 0,
        "affected_or_pending": 0,
        "cisa_kev": 0,
        "displayed": 0,
    }
    filtered_results = []

    rows = []
    for item in results:
        row_info = format_triage_row(item, rel_arg=rel_arg)
        triage_upper = row_info["triage_upper"]
        is_kev = row_info["is_kev"]

        if "NOT AFFECTED" in triage_upper:
            summary["not_affected"] += 1
        elif "UNPATCHED" in triage_upper or "PARTIALLY" in triage_upper or "IN QA" in triage_upper or "AFFECTED" in triage_upper or "PENDING" in triage_upper:
            summary["affected_or_pending"] += 1
        elif "PATCHED" in triage_upper or "RELEASED" in triage_upper:
            summary["patched"] += 1
        else:
            summary["affected_or_pending"] += 1

        if is_kev:
            summary["cisa_kev"] += 1

        is_open = not ("NOT AFFECTED" in triage_upper or triage_upper.startswith("PATCHED") or triage_upper.startswith("RELEASED"))
        if only_open and not is_open:
            continue
        if only_kev and not is_kev:
            continue

        filtered_results.append(item)
        rows.append({
            "cve": row_info["cve"],
            "status": row_info["status"],
            "status_detail": row_info["status_detail"],
            "severity": row_info["severity"],
            "lifecycle": row_info["lifecycle"],
            "action": row_info["action"],
        })

    summary["displayed"] = len(rows)
    if as_json:
        payload = {
            "batch": True,
            "release": rel_arg,
            "filter": status_filter or "ALL",
            "batch_filters": {"only_open": only_open, "only_kev": only_kev},
            "summary": summary,
            "rows": rows,
            "results": filtered_results,
            "errors": errors,
        }
        print(json.dumps(payload, indent=2))
        sys.exit(0 if results else 1)

    if as_csv:
        print(render_batch_csv_report(rel_arg, rows, filtered_results))
        sys.exit(0 if results else 1)

    if as_markdown:
        print(render_batch_markdown_report(rel_arg, summary, rows, filtered_results, errors, status_filter=status_filter, only_open=only_open, only_kev=only_kev))
        sys.exit(0 if results else 1)

    if config_mode == "salt":
        print(render_batch_salt_config(rel_arg, filtered_results, force_workaround=force_workaround))
        sys.exit(0 if results else 1)
    if config_mode == "ansible":
        print(render_batch_ansible_config(rel_arg, filtered_results, force_workaround=force_workaround))
        sys.exit(0 if results else 1)

    print(f"{CLR_BOLD}[EXECUTIVE BATCH TRIAGE SUMMARY]{CLR_RESET}  Target: {CLR_CYAN}{rel_arg}{CLR_RESET} | Total: {summary['total']} | Open/Pending: {CLR_WARN}{summary['affected_or_pending']}{CLR_RESET} | Patched: {CLR_CYAN}{summary['patched']}{CLR_RESET} | Not Affected: {summary['not_affected']} | CISA KEV: {CLR_MAG if summary['cisa_kev'] else ''}{summary['cisa_kev']}{CLR_RESET}\n")

    w_cve = max([len("CVE")] + [len(r["cve"]) for r in rows])
    w_st = max([len("STATUS")] + [len(r["status"]) for r in rows])
    w_sev = max([len("SEVERITY")] + [len(r["severity"]) for r in rows])
    w_lc = max([len("LIFECYCLE")] + [len(r["lifecycle"]) for r in rows])

    header = f"  {'CVE':<{w_cve}}  {'STATUS':<{w_st}}  {'SEVERITY':<{w_sev}}  {'LIFECYCLE':<{w_lc}}  PATCHES / ACTION"
    print(f"{CLR_BOLD}{header}{CLR_RESET}")
    print("  " + "-" * (len(header) - 2))
    if not rows:
        print(f"  {CLR_DIM}No CVEs matched the active batch filter (--only-open / --only-kev).{CLR_RESET}")
    for r in rows:
        st_up = r["status"].upper()
        st_col = CLR_CYAN if ("NOT AFFECTED" in st_up or st_up.startswith("PATCHED") or st_up.startswith("RELEASED")) else CLR_WARN
        print(f"  {r['cve']:<{w_cve}}  {st_col}{r['status']:<{w_st}}{CLR_RESET}  {r['severity']:<{w_sev}}  {r['lifecycle']:<{w_lc}}  {r['action']}")

    open_action_rows = [
        r for r in rows
        if not ("NOT AFFECTED" in r["status"].upper() or r["status"].upper().startswith("PATCHED") or r["status"].upper().startswith("RELEASED"))
    ]
    if open_action_rows:
        print(f"\n{CLR_WARN}[ACTION REQUIRED — OPEN / UNPATCHED CVEs ({len(open_action_rows)})]{CLR_RESET}")
        print("  Review compensating mitigations & remediation steps for open vulnerabilities:")
        for ur in open_action_rows:
            st_u = ur["status"].upper()
            flag = "--remediate" if ("PARTIALLY" in st_u and not ur["action"].startswith(("suse-cve ", "No Patch", "Patch "))) else "--mitigate"
            print(f"  -> {CLR_BOLD}suse-cve {rel_arg} {ur['cve']} {flag}{CLR_RESET}  [{ur['status']} | {ur['severity']}]")

    if errors:
        print(f"\n{CLR_MAG}[BATCH ERRORS]{CLR_RESET}")
        for e in errors:
            print(f"  - {e['cve']}: {e['error']}")

    print(f"\n{CLR_DIM}[STATUS GUIDE — RISK & NEXT STEPS]{CLR_RESET}")
    print(f"  {CLR_DIM}• PATCHED           : Vendor fix available; install via zypper / transactional-update.{CLR_RESET}")
    print(f"  {CLR_DIM}• PARTIALLY PATCHED : Core fix available, some sub-packages still open — run --remediate & check installed RPMs.{CLR_RESET}")
    print(f"  {CLR_DIM}• IN QA / UNPATCHED : No full target patch released yet — apply --mitigate workarounds & check service exposure.{CLR_RESET}")
    print(f"  {CLR_DIM}• NOT AFFECTED      : Target release is not vulnerable — no action required.{CLR_RESET}")

    if view_mode in ("remediate", "mitigate") and filtered_results:
        mode_banner = "REMEDIATION (VENDOR PATCHES)" if view_mode == "remediate" else "MITIGATIONS (COMPENSATING WORKAROUNDS)"
        print(f"\n{CLR_BOLD}{'=' * 79}{CLR_RESET}")
        print(f"{CLR_BOLD}[BATCH {mode_banner}]{CLR_RESET}")
        print(f"{CLR_BOLD}{'=' * 79}{CLR_RESET}")
        rendered_any = False
        for item in filtered_results:
            meta = item.get("meta", {})
            triage_full = meta.get("triage_status", "UNKNOWN")
            triage_short = triage_full.split("(", 1)[0].strip() if "(" in triage_full else triage_full
            if "NOT AFFECTED" in triage_short.upper():
                continue
            mit_block = item.get("mitigation")
            if not mit_block:
                continue
            rendered_any = True
            cve_id = item.get("cve", "")
            st_col = CLR_CYAN if (triage_short.upper().startswith("PATCHED") or triage_short.upper().startswith("RELEASED")) else CLR_WARN
            print(f"\n{CLR_BOLD}>>> {cve_id} | {rel_arg.upper()} | {st_col}{triage_short}{CLR_RESET}{CLR_BOLD} <<<{CLR_RESET}")
            print_mitigation_block(mit_block, view_mode=view_mode)
        if not rendered_any:
            print(f"  {CLR_DIM}All scanned CVEs are NOT AFFECTED on {rel_arg} — no {view_mode} actions required.{CLR_RESET}")

    print("")
    sys.exit(0 if results else 1)


if __name__ == "__main__":
    if len(sys.argv) == 2 and sys.argv[1] in ("--update", "--reindex"):
        build_index()
        sys.exit(0)
    if len(sys.argv) == 2 and sys.argv[1] == "--sync":
        sync_oval_files()
        sys.exit(0)

    raw_args = sys.argv[1:]
    as_json = "--json" in raw_args
    if as_json:
        raw_args.remove("--json")

    as_csv = "--csv" in raw_args
    if as_csv:
        raw_args.remove("--csv")

    as_markdown = any(a in ("--markdown", "--md") for a in raw_args)
    raw_args = [a for a in raw_args if a not in ("--markdown", "--md")]

    only_open = "--only-open" in raw_args
    if only_open:
        raw_args.remove("--only-open")

    only_kev = "--only-kev" in raw_args
    if only_kev:
        raw_args.remove("--only-kev")

    as_table = any(a in ("--table", "-t") for a in raw_args)
    raw_args = [a for a in raw_args if a not in ("--table", "-t")]

    with_remediation = False
    for flag in ("--remediate", "--fix"):
        if flag in raw_args:
            with_remediation = True
            raw_args.remove(flag)

    with_mitigation = False
    for flag in ("--mitigate", "-m", "--mitigation", "--workaround"):
        if flag in raw_args:
            with_mitigation = True
            raw_args.remove(flag)

    config_mode = None
    for flag in ("--salt-config", "--salt"):
        if flag in raw_args:
            config_mode = "salt"
            raw_args.remove(flag)
    for flag in ("--ansible-config", "--ansible"):
        if flag in raw_args:
            config_mode = "ansible"
            raw_args.remove(flag)

    # In IaC generation mode: --mitigate forces compensating workarounds; --remediate applies vendor patches
    force_workaround = bool(config_mode and with_mitigation and not with_remediation)

    if config_mode and not (with_mitigation or with_remediation):
        with_remediation = True

    batch_file = None
    filtered_args = []
    i = 0
    while i < len(raw_args):
        tok = raw_args[i]
        if tok in ("--file", "-f"):
            if i + 1 >= len(raw_args):
                print("Error: --file requires a path (or '-' for stdin).", file=sys.stderr)
                sys.exit(1)
            batch_file = raw_args[i + 1]
            i += 2
            continue
        if tok.startswith("--file="):
            batch_file = tok.split("=", 1)[1]
            i += 1
            continue
        filtered_args.append(tok)
        i += 1
    raw_args = filtered_args

    if len(raw_args) >= 1 and re.match(r'^(CVE-)?\d{4}-\d+([,;].*)?$', raw_args[0], re.IGNORECASE):
        raw_args.insert(0, "all")
    elif batch_file is not None and len(raw_args) == 0:
        raw_args.insert(0, "all")

    want_help = any(a in ("-h", "--help") for a in sys.argv[1:])
    if want_help or (batch_file is None and len(raw_args) < 2) or (batch_file is not None and len(raw_args) < 1):
        print("Usage   : suse-cve [<release>] <cve[,cve2,...]> [status_filter] [--remediate | --mitigate] [--salt-config | --ansible-config] [--table] [--only-open] [--only-kev] [--json | --csv | --markdown]")
        print("          suse-cve [<release>] --file <cve_list.txt | -> [status_filter] [--remediate | --mitigate] [--salt-config | --ansible-config] [--only-open] [--only-kev] [--json | --csv | --markdown]")
        print("Examples: suse-cve 15sp7 CVE-2026-98432")
        print("          suse-cve 15sp7 CVE-2026-97876,CVE-2026-98432")
        print("          suse-cve 15sp7 --file cves.txt --json                 (Batch triage from file with JSON)")
        print("          cat cves.txt | suse-cve 15sp7 -f -                    (Batch triage from stdin pipeline)")
        print("          suse-cve 15sp7 CVE-2026-98432 --remediate   (Vendor patch remediation + fallback workarounds)")
        print("          suse-cve 15sp7 CVE-2026-98432 --mitigate    (Compensating workarounds / hardening)")
        print("          suse-cve 15sp7 CVE-2026-98432 --remediate --salt-config   (SaltStack patch state)")
        print("          suse-cve 15sp7 CVE-2026-98432 --mitigate --salt-config    (SaltStack workaround state)")
        print("          suse-cve 15sp7 CVE-2026-98432 --mitigate --ansible-config (Ansible workaround playbook)")
        print("          suse-cve all CVE-2026-98432 rel --json")
        print("          suse-cve --sync   (Download OVAL dumps and rebuild local index)")
        sys.exit(1)

    if with_mitigation and not with_remediation:
        view_mode = "mitigate"
    elif with_remediation and not with_mitigation:
        view_mode = "remediate"
    else:
        view_mode = "all"

    with_mitigation = True

    known_filters = {"rel", "released", "qa", "inqa", "aff", "affected", "inp", "inprogress", "wont", "wontfix", "all"}
    cve_tokens = []
    filter_arg = None

    if len(raw_args) >= 3 and os.path.basename(raw_args[1]) == "suse-cve":
        if len(raw_args) >= 4 and re.match(r"^(all|sles|sled|sl-?micro|micro|leap|tumbleweed|\d+)", raw_args[2], re.I):
            raw_args = [raw_args[0]] + raw_args[3:]
        else:
            raw_args = [raw_args[0]] + raw_args[2:]

    if batch_file is not None:
        for extra in raw_args[1:]:
            if extra.lower() in known_filters and filter_arg is None:
                filter_arg = extra
            else:
                cve_tokens.append(extra)
        batch_cves = extract_batch_cves(cve_tokens, file_path=batch_file)
        run_batch_query(raw_args[0], batch_cves, filter_arg, as_json=as_json, as_csv=as_csv, as_markdown=as_markdown, with_mitigation=with_mitigation, config_mode=config_mode, force_workaround=force_workaround, view_mode=view_mode, only_open=only_open, only_kev=only_kev)
    else:
        first_cve_tok = raw_args[1]
        extra_tokens = raw_args[2:]
        extra_cves = [t for t in extra_tokens if t.lower() not in known_filters]
        for t in extra_tokens:
            if t.lower() in known_filters and filter_arg is None:
                filter_arg = t
        try:
            if "," in first_cve_tok or ";" in first_cve_tok or extra_cves or as_table or only_open or only_kev or as_csv or as_markdown:
                batch_cves = extract_batch_cves([first_cve_tok] + extra_cves)
                run_batch_query(raw_args[0], batch_cves, filter_arg, as_json=as_json, as_csv=as_csv, as_markdown=as_markdown, with_mitigation=with_mitigation, config_mode=config_mode, force_workaround=force_workaround, view_mode=view_mode, only_open=only_open, only_kev=only_kev)
            else:
                query(raw_args[0], first_cve_tok, filter_arg, as_json=as_json, with_mitigation=with_mitigation, config_mode=config_mode, force_workaround=force_workaround, view_mode=view_mode)
            sys.stdout.flush()
        except BrokenPipeError:
            os._exit(0)
